diff -ruN a/src/nautilus-details-pane.c b/src/nautilus-details-pane.c
--- a/src/nautilus-details-pane.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/nautilus-details-pane.c	2026-11-01 04:01:22.690329213 +0100
@@ -0,0 +1,840 @@
+/*
+ * CodLab — incremento 2 «Nautilus potente»: riquadro dettagli (implementazione).
+ *
+ * Pannello fisso a destra: anteprima grande (NautilusImage, la glycin della
+ * finestra Proprietà riusata tale e quale) e metadati del file selezionato.
+ * La selezione arriva dalla proprietà «selection» dello slot attivo
+ * (bind template.active-slot, come la barra laterale): niente connessioni
+ * dirette alla view, che il cambio grid/elenco ricrea.
+ *
+ * I metadati foto/video si leggono in un GTask di worker: EXIF con gexiv2
+ * (stessi campi e stessi formati di colonne-foto.py dell'INC-1: dimensioni
+ * «WxH» con orientamento applicato, scatto «YYYY-MM-DD HH:MM», fotocamera
+ * «Marca Modello»), durata e risoluzione dei video con GstDiscoverer. Sono
+ * librerie che il binario nautilus GIÀ linka oggi (via libnautilus-extension:
+ * rpm -q --requires nautilus): nessuna dipendenza nuova, nessun subprocess.
+ * Ogni risultato stantio (selezione cambiata mentre il worker girava) viene
+ * scartato; ogni errore lascia semplicemente via la riga, mai un crash.
+ *
+ * Il template (nautilus-details-pane.blp) NON ha callback: tutte le
+ * connessioni sono qui in C, gtk_widget_class_bind_template_callback non
+ * serve (lezione 2 di INC-1: zero Gtk-CRITICAL garantiti per costruzione).
+ */
+#include "nautilus-details-pane.h"
+
+#include <glib/gi18n.h>
+
+#include "nautilus-file.h"
+#include "nautilus-global-preferences.h"
+#include "nautilus-image.h"
+#include "nautilus-window-slot.h"
+
+#include <gexiv2/gexiv2.h>
+#include <gst/gst.h>
+#include <gst/pbutils/pbutils.h>
+
+/* Larghezza del riquadro, fissa come la colonna anteprima di Finder. */
+#define DETAILS_PANE_WIDTH 320
+/* Dimensione dell'anteprima caduta (la stessa sorgente delle miniature). */
+#define DETAILS_PANE_ICON_SIZE 256
+/* Il «changed» del file arriva a raffica: si raggruppa come fa la finestra
+ * delle proprietà (FILES_UPDATE_INTERVAL). */
+#define DETAILS_CHANGED_INTERVAL_MS 400
+/* Quanto lasciare lavorare GstDiscoverer prima di arrendersi. */
+#define DETAILS_DISCOVER_TIMEOUT_S 5
+
+struct _NautilusDetailsPane
+{
+    AdwBin parent_instance;
+
+    GtkWidget *preview;
+    GtkWidget *name_label;
+    GtkWidget *kind_label;
+    GtkWidget *hint_label;
+    GtkWidget *metadata_box;
+
+    NautilusWindowSlot *slot;
+    GSignalGroup *slot_signal_group;
+
+    GList *files;             /* NautilusFile della selezione (con ref) */
+    NautilusFile *monitored;  /* primo file, monitorato per i «changed» */
+    guint changed_timeout_id;
+
+    GCancellable *metadata_cancellable;
+    gchar *metadata_uri;      /* uri atteso quando il worker finisce */
+    time_t metadata_mtime;
+
+    gboolean revealed;
+};
+
+enum
+{
+    PROP_0,
+    PROP_WINDOW_SLOT,
+    PROP_REVEALED,
+    N_PROPS,
+};
+
+static GParamSpec *properties[N_PROPS];
+
+static void refresh_selection (NautilusDetailsPane *self);
+static void cancel_metadata (NautilusDetailsPane *self);
+static void clear_files (NautilusDetailsPane *self);
+static void file_changed (NautilusFile *file, gpointer user_data);
+static void start_metadata_task (NautilusDetailsPane *self,
+                                 NautilusFile        *file,
+                                 gboolean             is_video);
+void details_pane_add_row (NautilusDetailsPane *self,
+                           const gchar         *caption,
+                           const gchar         *value);
+
+G_DEFINE_FINAL_TYPE (NautilusDetailsPane, nautilus_details_pane, ADW_TYPE_BIN)
+
+/* ------------------------------------------------------------------ */
+/* Dati e risultato del worker dei metadati foto/video                  */
+/* ------------------------------------------------------------------ */
+
+typedef struct
+{
+    gchar *uri;
+    gchar *path;      /* serve a gexiv2: percorso locale, NULL se remoto */
+    time_t mtime;
+    gboolean is_video;
+} MetadataTaskData;
+
+typedef struct
+{
+    gchar *camera;
+    gchar *taken;
+    gchar *dimensions;
+    gchar *duration;
+} MetadataResult;
+
+static void
+metadata_task_data_free (MetadataTaskData *data)
+{
+    g_clear_pointer (&data->uri, g_free);
+    g_clear_pointer (&data->path, g_free);
+    g_free (data);
+}
+
+static void
+metadata_result_free (MetadataResult *result)
+{
+    if (result == NULL)
+    {
+        return;
+    }
+    g_clear_pointer (&result->camera, g_free);
+    g_clear_pointer (&result->taken, g_free);
+    g_clear_pointer (&result->dimensions, g_free);
+    g_clear_pointer (&result->duration, g_free);
+    g_free (result);
+}
+
+/* lettura di un tag EXIF come stringa: NULL se manca (gexiv2 vuole
+ * GError**, un tag assente non e' un errore nostro) */
+static gchar *
+read_tag_string (GExiv2Metadata *metadata,
+                 const gchar    *tag)
+{
+    g_autofree gchar *value = gexiv2_metadata_get_tag_string (metadata, tag, NULL);
+    if (value == NULL || *value == '\0')
+    {
+        return NULL;
+    }
+    return g_steal_pointer (&value);
+}
+
+/* «2026:03:14 09:15:00» -> «2026-03-14 09:15», come colonne-foto.py */
+static gchar *
+normalize_taken (const gchar *raw)
+{
+    if (raw == NULL || strlen (raw) < 16 || raw[4] != ':' || raw[7] != ':')
+    {
+        return NULL;
+    }
+    gchar *out = g_strndup (raw, 16);
+    out[4] = '-';
+    out[7] = '-';
+    return out;
+}
+
+/* «Canon» + «EOS R5» -> «Canon EOS R5»; se il modello inizia con la marca
+ * resta il modello solo (stessa logica di colonne-foto.py). */
+static gchar *
+compose_camera (const gchar *make,
+                const gchar *model)
+{
+    if (make == NULL || *make == '\0')
+    {
+        return g_strdup (model);
+    }
+    if (model == NULL || *model == '\0')
+    {
+        return g_strdup (make);
+    }
+    if (g_str_has_prefix (model, make))
+    {
+        return g_strdup (model);
+    }
+    return g_strdup_printf ("%s %s", make, model);
+}
+
+/* 5..8 = orientamenti che scambiano gli assi: un ritratto dice 1600x2400
+ * (stessa logica di colonne-foto.py). */
+static gboolean
+orientation_swaps_axes (const gchar *orientation)
+{
+    gint64 value = g_ascii_strtoll (orientation != NULL ? orientation : "1", NULL, 10);
+    return value >= 5 && value <= 8;
+}
+
+/* «61 s» -> «1:01», «3661 s» -> «1:01:01» (stesso formato di
+ * colonne-video.py: minuti:secondi, ore davanti solo se servono). */
+static gchar *
+format_duration (guint64 seconds)
+{
+    if (seconds >= 3600)
+    {
+        return g_strdup_printf ("%" G_GUINT64_FORMAT ":%02" G_GUINT64_FORMAT
+                                ":%02" G_GUINT64_FORMAT,
+                                seconds / 3600, (seconds % 3600) / 60, seconds % 60);
+    }
+    return g_strdup_printf ("%" G_GUINT64_FORMAT ":%02" G_GUINT64_FORMAT,
+                            seconds / 60, seconds % 60);
+}
+
+static gpointer
+ensure_gst_once (gpointer user_data)
+{
+    if (!gst_is_initialized ())
+    {
+        gst_init (NULL, NULL);
+    }
+    return NULL;
+}
+
+static void
+read_photo_metadata (MetadataTaskData *data,
+                     MetadataResult  *result)
+{
+    GError *error = NULL;
+    g_autoptr (GExiv2Metadata) metadata = gexiv2_metadata_new ();
+
+    if (metadata == NULL)
+    {
+        return;
+    }
+    if (data->path == NULL || !gexiv2_metadata_open_path (metadata, data->path, &error))
+    {
+        /* file remoto, non leggibile, EXIF assente o formato che exiv2 non
+         * parla: niente righe foto, ma niente nemmeno da segnalare */
+        g_clear_error (&error);
+        return;
+    }
+
+    g_autofree gchar *make = read_tag_string (metadata, "Exif.Image.Make");
+    g_autofree gchar *model = read_tag_string (metadata, "Exif.Image.Model");
+    g_autofree gchar *orientation = read_tag_string (metadata, "Exif.Image.Orientation");
+    g_autofree gchar *taken_raw = read_tag_string (metadata, "Exif.Photo.DateTimeOriginal");
+    if (taken_raw == NULL)
+    {
+        taken_raw = read_tag_string (metadata, "Exif.Image.DateTime");
+    }
+
+    if (make != NULL) g_strstrip (make);
+    if (model != NULL) g_strstrip (model);
+
+    /* read_tag_string restituisce NULL quando il tag non c'e': un'immagine
+     * senza EXIF (PNG piatto, JPEG spogliato) non deve dereferenziarlo
+     * (rilievo R1 della revisione: SIGSEGV 139 anche a pannello chiuso) */
+    result->camera = compose_camera (make != NULL && *make != '\0' ? make : NULL,
+                                     model != NULL && *model != '\0' ? model : NULL);
+    result->taken = normalize_taken (taken_raw);
+
+    /* le dimensioni si leggono dai tag PixelX/PixelY del SUB-IFD (quello
+     * che leggono le colonne foto di INC-1), con le dimensioni strutturali
+     * di gexiv2 come risvolto per i file senza quei tag */
+    gint width = 0;
+    gint height = 0;
+    g_autofree gchar *pixel_x = read_tag_string (metadata, "Exif.Photo.PixelXDimension");
+    g_autofree gchar *pixel_y = read_tag_string (metadata, "Exif.Photo.PixelYDimension");
+    if (pixel_x != NULL && pixel_y != NULL)
+    {
+        width = (gint) g_ascii_strtoll (pixel_x, NULL, 10);
+        height = (gint) g_ascii_strtoll (pixel_y, NULL, 10);
+    }
+    else
+    {
+        width = gexiv2_metadata_get_pixel_width (metadata);
+        height = gexiv2_metadata_get_pixel_height (metadata);
+    }
+    if (width > 0 && height > 0)
+    {
+        gint x = width;
+        gint y = height;
+        if (orientation_swaps_axes (orientation))
+        {
+            x = height;
+            y = width;
+        }
+        result->dimensions = g_strdup_printf ("%dx%d", x, y);
+    }
+}
+
+static void
+read_video_metadata (MetadataTaskData *data,
+                     MetadataResult  *result)
+{
+    GError *error = NULL;
+    static GOnce gst_once = G_ONCE_INIT;
+
+    g_once (&gst_once, ensure_gst_once, NULL);
+
+    g_autoptr (GstDiscoverer) discoverer = gst_discoverer_new (
+        DETAILS_DISCOVER_TIMEOUT_S * GST_SECOND, &error);
+    if (discoverer == NULL)
+    {
+        g_clear_error (&error);
+        return;
+    }
+
+    g_autoptr (GstDiscovererInfo) info =
+        gst_discoverer_discover_uri (discoverer, data->uri, &error);
+    if (info == NULL)
+    {
+        /* file rotto, codec senza demuxer, timeout: solo righe assenti */
+        g_clear_error (&error);
+        return;
+    }
+
+    const guint64 duration_ns = gst_discoverer_info_get_duration (info);
+    if (duration_ns != 0 && duration_ns != GST_CLOCK_TIME_NONE &&
+        duration_ns >= GST_SECOND)
+    {
+        result->duration = format_duration (duration_ns / GST_SECOND);
+    }
+
+    GList *video_streams = (GList *) gst_discoverer_info_get_video_streams (info);
+    if (video_streams != NULL)
+    {
+        const guint width = gst_discoverer_video_info_get_width (video_streams->data);
+        const guint height = gst_discoverer_video_info_get_height (video_streams->data);
+        if (width > 0 && height > 0)
+        {
+            result->dimensions = g_strdup_printf ("%ux%u", width, height);
+        }
+        gst_discoverer_stream_info_list_free (video_streams);
+    }
+}
+
+static void
+metadata_task_worker (GTask        *task,
+                      gpointer      source_object,
+                      gpointer      task_data,
+                      GCancellable *cancellable)
+{
+    MetadataTaskData *data = task_data;
+    MetadataResult *result = g_new0 (MetadataResult, 1);
+
+    if (g_task_return_error_if_cancelled (task))
+    {
+        metadata_result_free (result);
+        return;
+    }
+
+    if (data->is_video)
+    {
+        read_video_metadata (data, result);
+    }
+    else
+    {
+        read_photo_metadata (data, result);
+    }
+
+    g_task_return_pointer (task, result, (GDestroyNotify) metadata_result_free);
+}
+
+static void
+metadata_task_done (GObject      *source_object,
+                    GAsyncResult *result,
+                    gpointer      user_data)
+{
+    NautilusDetailsPane *self = NAUTILUS_DETAILS_PANE (user_data);
+    GError *error = NULL;
+    MetadataResult *metadata = g_task_propagate_pointer (G_TASK (result), &error);
+
+    if (metadata == NULL)
+    {
+        /* annullato: la selezione e' cambiata mentre il worker girava, o la
+         * finestra e' stata chiusa: il risultato non e' piu' di nessuno */
+        g_clear_error (&error);
+        return;
+    }
+
+    /* risultato stantio: il file monitorato ora e' un altro (uri o mtime
+     * diversi da quelli che il worker ha letto): si scarta */
+    if (self->monitored != NULL && self->metadata_uri != NULL)
+    {
+        g_autofree gchar *uri = nautilus_file_get_uri (self->monitored);
+        if (g_strcmp0 (uri, self->metadata_uri) == 0 &&
+            nautilus_file_get_mtime (self->monitored) == self->metadata_mtime)
+        {
+            if (metadata->camera != NULL)
+            {
+                details_pane_add_row (self, _("Camera"), metadata->camera);
+            }
+            if (metadata->taken != NULL)
+            {
+                details_pane_add_row (self, _("Date Taken"), metadata->taken);
+            }
+            if (metadata->dimensions != NULL)
+            {
+                details_pane_add_row (self, _("Dimensions"), metadata->dimensions);
+            }
+            if (metadata->duration != NULL)
+            {
+                details_pane_add_row (self, _("Duration"), metadata->duration);
+            }
+        }
+    }
+
+    metadata_result_free (metadata);
+}
+
+static void
+start_metadata_task (NautilusDetailsPane *self,
+                     NautilusFile        *file,
+                     gboolean             is_video)
+{
+    g_autoptr (GFile) location = nautilus_file_get_location (file);
+    g_autofree gchar *path = g_file_get_path (location);
+
+    /* remoto o non ancora risolvibile: EXIF non si legge, le righe base
+     * (tipo, dimensione, date, permessi) restano e sono gia' al loro posto */
+    if (!is_video && path == NULL)
+    {
+        return;
+    }
+
+    cancel_metadata (self);
+
+    MetadataTaskData *data = g_new0 (MetadataTaskData, 1);
+    data->uri = nautilus_file_get_uri (file);
+    data->path = g_strdup (path);
+    data->mtime = nautilus_file_get_mtime (file);
+    data->is_video = is_video;
+
+    self->metadata_cancellable = g_cancellable_new ();
+    self->metadata_uri = g_strdup (data->uri);
+    self->metadata_mtime = data->mtime;
+
+    GTask *task = g_task_new (self, self->metadata_cancellable,
+                              metadata_task_done, self);
+    g_task_set_task_data (task, data, (GDestroyNotify) metadata_task_data_free);
+    g_task_run_in_thread (task, metadata_task_worker);
+    g_object_unref (task);
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                            */
+/* ------------------------------------------------------------------ */
+
+void
+details_pane_add_row (NautilusDetailsPane *self,
+                      const gchar         *caption,
+                      const gchar         *value)
+{
+    GtkWidget *row = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+    GtkWidget *caption_label = gtk_label_new (caption);
+    GtkWidget *value_label = gtk_label_new (value);
+
+    gtk_label_set_wrap (GTK_LABEL (caption_label), TRUE);
+    gtk_label_set_xalign (GTK_LABEL (caption_label), 0.0);
+    gtk_widget_add_css_class (caption_label, "dim-label");
+
+    gtk_label_set_wrap (GTK_LABEL (value_label), TRUE);
+    gtk_label_set_xalign (GTK_LABEL (value_label), 1.0);
+    gtk_widget_set_hexpand (value_label, TRUE);
+
+    gtk_box_append (GTK_BOX (row), caption_label);
+    gtk_box_append (GTK_BOX (row), value_label);
+    gtk_box_append (GTK_BOX (self->metadata_box), row);
+}
+
+static void
+clear_metadata_rows (NautilusDetailsPane *self)
+{
+    GtkWidget *child = gtk_widget_get_first_child (self->metadata_box);
+    while (child != NULL)
+    {
+        GtkWidget *next = gtk_widget_get_next_sibling (child);
+        gtk_box_remove (GTK_BOX (self->metadata_box), child);
+        child = next;
+    }
+}
+
+static void
+cancel_metadata (NautilusDetailsPane *self)
+{
+    if (self->metadata_cancellable != NULL)
+    {
+        g_cancellable_cancel (self->metadata_cancellable);
+        g_clear_object (&self->metadata_cancellable);
+    }
+    g_clear_pointer (&self->metadata_uri, g_free);
+}
+
+static void
+clear_files (NautilusDetailsPane *self)
+{
+    cancel_metadata (self);
+
+    if (self->changed_timeout_id != 0)
+    {
+        g_source_remove (self->changed_timeout_id);
+        self->changed_timeout_id = 0;
+    }
+    if (self->monitored != NULL)
+    {
+        g_signal_handlers_disconnect_by_func (self->monitored,
+                                              G_CALLBACK (file_changed),
+                                              self);
+        nautilus_file_monitor_remove (self->monitored, &self->files);
+        g_clear_object (&self->monitored);
+    }
+    g_clear_pointer (&self->files, nautilus_file_list_free);
+}
+
+static gboolean
+refresh_from_changed (NautilusDetailsPane *self)
+{
+    self->changed_timeout_id = 0;
+    refresh_selection (self);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+file_changed (NautilusFile *file,
+              gpointer      user_data)
+{
+    NautilusDetailsPane *self = NAUTILUS_DETAILS_PANE (user_data);
+
+    if (self->changed_timeout_id == 0)
+    {
+        self->changed_timeout_id = g_timeout_add (DETAILS_CHANGED_INTERVAL_MS,
+                                                  G_SOURCE_FUNC (refresh_from_changed),
+                                                  self);
+    }
+}
+
+static void
+render_multiple (NautilusDetailsPane *self,
+                 guint                n_items)
+{
+    g_autofree gchar *title = g_strdup_printf (
+        ngettext ("%u item selected", "%u items selected", n_items), n_items);
+
+    gtk_label_set_text (GTK_LABEL (self->name_label), title);
+    gtk_label_set_text (GTK_LABEL (self->kind_label), "");
+
+    /* selezione multipla: via l'anteprima e il tipo del file SINGOLO
+     * precedente (rilievo R5 della revisione: la miniatura vecchia
+     * restava sopra «N elementi selezionati»). refresh_selection li
+     * rimette visibili quando torna la selezione singola. */
+    gtk_widget_set_visible (self->preview, FALSE);
+    gtk_widget_set_visible (self->kind_label, FALSE);
+
+    goffset total = 0;
+    gboolean any_size = FALSE;
+    for (GList *l = self->files; l != NULL; l = l->next)
+    {
+        NautilusFile *file = NAUTILUS_FILE (l->data);
+        if (!nautilus_file_is_directory (file))
+        {
+            total += nautilus_file_get_size (file);
+            any_size = TRUE;
+        }
+    }
+    if (any_size)
+    {
+        g_autofree gchar *size = g_format_size (total);
+        details_pane_add_row (self, _("Total size"), size);
+    }
+}
+
+static void
+render_single (NautilusDetailsPane *self)
+{
+    NautilusFile *file = NAUTILUS_FILE (self->files->data);
+    const gint scale = gtk_widget_get_scale_factor (GTK_WIDGET (self));
+    const NautilusFileIconFlags flags =
+        NAUTILUS_FILE_ICON_FLAGS_USE_THUMBNAILS |
+        NAUTILUS_FILE_ICON_FLAGS_USE_MOUNT_ICON;
+
+    /* la stringa di get_string_attribute e' NOSTRA (char *: il chiamante
+     * la possiede, nautilus-file.h:352) — difetto F3: prima si perdeva
+     * a ogni aggiornamento delle righe */
+    g_autofree gchar *kind =
+        nautilus_file_get_string_attribute (file, "detailed_type");
+    gtk_label_set_text (GTK_LABEL (self->name_label),
+                        nautilus_file_get_display_name (file));
+    gtk_label_set_text (GTK_LABEL (self->kind_label),
+                        kind != NULL ? kind : "");
+    gtk_widget_set_visible (self->preview, TRUE);
+    gtk_widget_set_visible (self->kind_label, TRUE);
+
+    /* anteprima: il gesto della finestra Proprietà, identico */
+    g_autoptr (GdkPaintable) paintable =
+        nautilus_file_get_icon_paintable (file, DETAILS_PANE_ICON_SIZE, scale, flags);
+    nautilus_image_set_fallback (NAUTILUS_IMAGE (self->preview), paintable);
+    if (nautilus_file_should_show_thumbnail (file))
+    {
+        g_autoptr (GFile) location = nautilus_file_get_location (file);
+        nautilus_image_set_source (NAUTILUS_IMAGE (self->preview), location);
+    }
+    else
+    {
+        nautilus_image_set_source (NAUTILUS_IMAGE (self->preview), NULL);
+    }
+
+    /* righe base: ogni attributo e' gia' localizzato da Nautilus; le righe
+     * senza valore (dimensione di una cartella a conteggio spento, data di
+     * creazione sconosciuta) semplicemente non ci sono */
+    const struct
+    {
+        const gchar *attribute;
+        const gchar *caption;
+    } base_rows[] = {
+        { "size", N_("Size") },
+        { "date_modified", N_("Modified") },
+        { "date_created", N_("Created") },
+        { "permissions", N_("Permissions") },
+    };
+    for (gsize i = 0; i < G_N_ELEMENTS (base_rows); i++)
+    {
+        g_autofree gchar *value =
+            nautilus_file_get_string_attribute (file, base_rows[i].attribute);
+        if (value != NULL && *value != '\0')
+        {
+            details_pane_add_row (self, gettext (base_rows[i].caption), value);
+        }
+    }
+
+    /* monitor: i «changed» del file rifanno il rendering (miniatura che
+     * arriva, attributi che si completano) */
+    self->monitored = g_object_ref (file);
+    nautilus_file_monitor_add (file, &self->files,
+                               NAUTILUS_ATTRIBUTE_THUMBNAIL_BUFFER);
+    g_signal_connect (file, "changed", G_CALLBACK (file_changed), self);
+
+    /* righe foto/video in un worker: EXIF con gexiv2, durata/risoluzione
+     * con GstDiscoverer (stessi formati di colonne-foto/colonne-video) */
+    const gchar *mime_type = nautilus_file_get_mime_type (file);
+    if (mime_type != NULL)
+    {
+        if (g_str_has_prefix (mime_type, "image/"))
+        {
+            start_metadata_task (self, file, FALSE);
+        }
+        else if (g_str_has_prefix (mime_type, "video/"))
+        {
+            start_metadata_task (self, file, TRUE);
+        }
+    }
+}
+
+static void
+refresh_selection (NautilusDetailsPane *self)
+{
+    clear_files (self);
+    clear_metadata_rows (self);
+
+    GList *selection = (self->slot != NULL)
+                       ? nautilus_window_slot_get_selection (self->slot)
+                       : NULL;
+    const guint n_items = g_list_length (selection);
+
+    const gboolean empty = (n_items == 0);
+    gtk_widget_set_visible (self->hint_label, empty);
+    gtk_widget_set_visible (self->preview, !empty);
+    gtk_widget_set_visible (self->name_label, !empty);
+    gtk_widget_set_visible (self->kind_label, !empty);
+    gtk_widget_set_visible (self->metadata_box, !empty);
+
+    if (empty)
+    {
+        gtk_label_set_text (GTK_LABEL (self->name_label), "");
+        gtk_label_set_text (GTK_LABEL (self->kind_label), "");
+        return;
+    }
+
+    self->files = nautilus_file_list_copy (selection);
+
+    if (n_items > 1)
+    {
+        render_multiple (self, n_items);
+        return;
+    }
+
+    render_single (self);
+}
+
+/* ------------------------------------------------------------------ */
+/* GObject                                                              */
+/* ------------------------------------------------------------------ */
+
+static void
+nautilus_details_pane_get_property (GObject    *object,
+                                    guint       property_id,
+                                    GValue     *value,
+                                    GParamSpec *pspec)
+{
+    NautilusDetailsPane *self = NAUTILUS_DETAILS_PANE (object);
+
+    switch (property_id)
+    {
+        case PROP_REVEALED:
+        {
+            g_value_set_boolean (value, self->revealed);
+        }
+        break;
+
+        default:
+        {
+            G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+        }
+        break;
+    }
+}
+
+static void
+nautilus_details_pane_set_property (GObject      *object,
+                                    guint         property_id,
+                                    const GValue *value,
+                                    GParamSpec   *pspec)
+{
+    NautilusDetailsPane *self = NAUTILUS_DETAILS_PANE (object);
+
+    switch (property_id)
+    {
+        case PROP_WINDOW_SLOT:
+        {
+            NautilusWindowSlot *slot = NAUTILUS_WINDOW_SLOT (g_value_get_object (value));
+            if (g_set_object (&self->slot, slot))
+            {
+                g_signal_group_set_target (self->slot_signal_group, slot);
+                refresh_selection (self);
+            }
+        }
+        break;
+
+        case PROP_REVEALED:
+        {
+            const gboolean revealed = g_value_get_boolean (value);
+            if (self->revealed != revealed)
+            {
+                self->revealed = revealed;
+                gtk_widget_set_visible (GTK_WIDGET (self), revealed);
+                /* lo schema nostro vive in un pacchetto a parte: se manca
+                 * (ritorno parziale) il pane funziona lo stesso di sessione,
+                 * senza persistenza e senza dereferenziare NULL */
+                if (nautilus_codlab_preferences != NULL)
+                {
+                    g_settings_set_boolean (
+                        nautilus_codlab_preferences,
+                        NAUTILUS_CODELAB_PREFERENCES_RIQUADRO_DETTAGLI,
+                        revealed);
+                }
+                g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_REVEALED]);
+            }
+        }
+        break;
+
+        default:
+        {
+            G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+        }
+        break;
+    }
+}
+
+static void
+nautilus_details_pane_dispose (GObject *object)
+{
+    NautilusDetailsPane *self = NAUTILUS_DETAILS_PANE (object);
+
+    clear_files (self);
+    g_clear_object (&self->slot_signal_group);
+    g_clear_object (&self->slot);
+
+    G_OBJECT_CLASS (nautilus_details_pane_parent_class)->dispose (object);
+}
+
+static void
+nautilus_details_pane_class_init (NautilusDetailsPaneClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+    object_class->get_property = nautilus_details_pane_get_property;
+    object_class->set_property = nautilus_details_pane_set_property;
+    object_class->dispose = nautilus_details_pane_dispose;
+
+    properties[PROP_WINDOW_SLOT] =
+        g_param_spec_object ("window-slot", NULL, NULL,
+                             NAUTILUS_TYPE_WINDOW_SLOT,
+                             G_PARAM_WRITABLE | G_PARAM_STATIC_STRINGS);
+
+    properties[PROP_REVEALED] =
+        g_param_spec_boolean ("revealed", NULL, NULL,
+                              FALSE,
+                              G_PARAM_READWRITE | G_PARAM_EXPLICIT_NOTIFY |
+                              G_PARAM_STATIC_STRINGS);
+    g_object_class_install_properties (object_class, N_PROPS, properties);
+
+    gtk_widget_class_set_template_from_resource (
+        widget_class, "/org/gnome/nautilus/ui/nautilus-details-pane.ui");
+
+    /* NautilusImage sta nel template: il suo GType va registrato prima
+     * dell'init (stesso gesto di grid-cell, name-cell e properties) */
+    g_type_ensure (NAUTILUS_TYPE_IMAGE);
+
+    gtk_widget_class_bind_template_child (widget_class, NautilusDetailsPane, preview);
+    gtk_widget_class_bind_template_child (widget_class, NautilusDetailsPane, name_label);
+    gtk_widget_class_bind_template_child (widget_class, NautilusDetailsPane, kind_label);
+    gtk_widget_class_bind_template_child (widget_class, NautilusDetailsPane, hint_label);
+    gtk_widget_class_bind_template_child (widget_class, NautilusDetailsPane, metadata_box);
+    /* Nessun gtk_widget_class_bind_template_callback serve qui: il template
+     * non ha handler (lezione 2 di INC-1). */
+}
+
+static void
+nautilus_details_pane_init (NautilusDetailsPane *self)
+{
+    gtk_widget_init_template (GTK_WIDGET (self));
+
+    /* lo stato ricordato: la chiave nostra, se lo schema c'e' (il lookup
+     * e' gia' stato fatto da nautilus_global_preferences_init) */
+    if (nautilus_codlab_preferences != NULL)
+    {
+        self->revealed = g_settings_get_boolean (
+            nautilus_codlab_preferences,
+            NAUTILUS_CODELAB_PREFERENCES_RIQUADRO_DETTAGLI);
+    }
+    gtk_widget_set_visible (GTK_WIDGET (self), self->revealed);
+
+    self->slot_signal_group = g_signal_group_new (NAUTILUS_TYPE_WINDOW_SLOT);
+    g_signal_group_connect_object (self->slot_signal_group, "notify::selection",
+                                   G_CALLBACK (refresh_selection),
+                                   self, G_CONNECT_SWAPPED);
+
+    refresh_selection (self);
+}
+
+GtkWidget *
+nautilus_details_pane_new (void)
+{
+    return g_object_new (NAUTILUS_TYPE_DETAILS_PANE, NULL);
+}
