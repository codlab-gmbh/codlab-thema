+/*
+ * CodLab — incremento 2 «Nautilus potente»: riquadro dettagli.
+ *
+ * NautilusDetailsPane: pannello fisso a destra della vista file, come il
+ * «Riquadro dettagli» di Explorer (Alt+P) e la colonna anteprima di Finder.
+ * Mostra l'anteprima grande del file selezionato e i suoi metadati
+ * (dimensioni, date, permessi; per foto anche fotocamera/data di
+ * scatto/dimensioni in pixel, per video durata e risoluzione).
+ *
+ * Lo stato aperto/chiuso vive nella chiave «riquadro-dettagli» dello schema
+ * NOSTRO org.gnome.nautilus.codlab; se lo schema manca (pacchetto a parte
+ * rimosso) il pane funziona lo stesso di sessione, senza persistenza e
+ * senza mai dereferenziare NULL.
+ */
+#pragma once
+
+#include <gtk/gtk.h>
+#include <adwaita.h>
+
+#include "nautilus-types.h"
+
+G_BEGIN_DECLS
+
+#define NAUTILUS_TYPE_DETAILS_PANE (nautilus_details_pane_get_type ())
+
+G_DECLARE_FINAL_TYPE (NautilusDetailsPane, nautilus_details_pane,
+                      NAUTILUS, DETAILS_PANE, AdwBin)
+
+GtkWidget *nautilus_details_pane_new (void);
+
+G_END_DECLS
