+++ b/src/resources/ui/nautilus-details-pane.blp	2026-11-01 00:13:25.321635535 +0100
@@ -0,0 +1,73 @@
+using Gtk 4.0;
+using Adw 1;
+
+/* CodLab (incremento 2 «Nautilus potente»): riquadro dettagli a destra.
+ * Nessun handler nel template: tutte le connessioni vivono in
+ * nautilus-details-pane.c (lezione 2 di INC-1: zero callback non bindati). */
+template $NautilusDetailsPane: Adw.Bin {
+  width-request: 320;
+
+  Gtk.Box {
+    orientation: horizontal;
+
+    Gtk.Separator {
+      orientation: vertical;
+    }
+
+    Gtk.ScrolledWindow {
+      hscrollbar-policy: never;
+      hexpand: true;
+
+      Gtk.Box {
+        orientation: vertical;
+        spacing: 12;
+        margin-top: 12;
+        margin-bottom: 12;
+        margin-start: 12;
+        margin-end: 12;
+
+        $NautilusImage preview {
+          size: 256;
+          halign: center;
+        }
+
+        Gtk.Label name_label {
+          wrap: true;
+          justify: center;
+
+          styles [
+            "title-4",
+          ]
+        }
+
+        Gtk.Label kind_label {
+          wrap: true;
+          justify: center;
+
+          styles [
+            "dim-label",
+            "caption",
+          ]
+        }
+
+        Gtk.Label hint_label {
+          visible: false;
+          wrap: true;
+          justify: center;
+          label: _("Select an item to see its details");
+
+          styles [
+            "dim-label",
+          ]
+        }
+
+        Gtk.Separator {}
+
+        Gtk.Box metadata_box {
+          orientation: vertical;
+          spacing: 8;
+        }
+      }
+    }
+  }
+}
