+/* Local sidebar groups: no Plex service calls or bookmark-file changes here. */
+static void
+update_group_visibility (NautilusSidebar *self)
+{
+    for (GtkWidget *row = gtk_widget_get_first_child (self->list_box); row != NULL;
+         row = gtk_widget_get_next_sibling (row))
+    {
+        NautilusSidebarSectionType section;
+        NautilusSidebarRowType type;
+
+        if (!NAUTILUS_IS_SIDEBAR_ROW (row))
+        {
+            continue;
+        }
+        g_object_get (row, "section-type", &section, "place-type", &type, NULL);
+        if (section == NAUTILUS_SIDEBAR_SECTION_MOUNTS &&
+            type != NAUTILUS_SIDEBAR_ROW_GROUP)
+        {
+            /* Use widget visibility for both native layout and accessibility. */
+            gtk_widget_set_visible (row, self->disks_expanded);
+        }
+        else if (section == NAUTILUS_SIDEBAR_SECTION_BOOKMARKS &&
+                 type != NAUTILUS_SIDEBAR_ROW_GROUP &&
+                 type != NAUTILUS_SIDEBAR_ROW_NEW_BOOKMARK)
+        {
+            gtk_widget_set_visible (row, self->work_expanded);
+        }
+        else if (section == NAUTILUS_SIDEBAR_SECTION_PLEX &&
+                 type != NAUTILUS_SIDEBAR_ROW_GROUP)
+        {
+            gtk_widget_set_visible (row, self->plex_expanded);
+        }
+    }
+}
+
+static void
+update_group_expanded (NautilusSidebar *self,
+                       GtkWidget       *toggle,
+                       gboolean         expanded)
+{
+    if (toggle != NULL)
+    {
+        GtkWidget *box = gtk_button_get_child (GTK_BUTTON (toggle));
+        GtkWidget *arrow = gtk_widget_get_last_child (box);
+
+        gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (toggle), expanded);
+        gtk_image_set_from_icon_name (GTK_IMAGE (arrow), expanded ?
+                                      "pan-down-symbolic" : "pan-end-symbolic");
+        gtk_accessible_update_state (GTK_ACCESSIBLE (toggle),
+                                     GTK_ACCESSIBLE_STATE_EXPANDED,
+                                     expanded, -1);
+    }
+    update_group_visibility (self);
+    /* Hiding rows never changes the viewed path. Restore its highlight on reveal. */
+    if (self->current_location != NULL)
+    {
+        nautilus_sidebar_set_location (self, self->current_location);
+    }
+}
+
+static void
+update_disks_expanded (NautilusSidebar *self)
+{
+    self->disks_expanded = g_settings_get_boolean (nautilus_preferences,
+                                                   "sidebar-disks-expanded");
+    update_group_expanded (self, self->disks_toggle, self->disks_expanded);
+}
+
+static void
+update_work_expanded (NautilusSidebar *self)
+{
+    self->work_expanded = g_settings_get_boolean (nautilus_preferences,
+                                                 "sidebar-work-expanded");
+    update_group_expanded (self, self->work_toggle, self->work_expanded);
+}
+
+static void
+update_plex_expanded (NautilusSidebar *self)
+{
+    self->plex_expanded = g_settings_get_boolean (nautilus_preferences,
+                                                  "sidebar-plex-expanded");
+    update_group_expanded (self, self->plex_toggle, self->plex_expanded);
+}
+
+static void
+group_toggled (GtkToggleButton *button,
+               NautilusSidebar *self)
+{
+    gboolean expanded = gtk_toggle_button_get_active (button);
+    const char *key = g_object_get_data (G_OBJECT (button), "expanded-key");
+
+    if (expanded != g_settings_get_boolean (nautilus_preferences, key))
+    {
+        g_settings_set_boolean (nautilus_preferences, key, expanded);
+    }
+}
+
+static void
+add_sidebar_group (NautilusSidebar            *self,
+                   NautilusSidebarSectionType  section,
+                   const char                 *title,
+                   gboolean                    collapsible)
+{
+    GtkWidget *row = g_object_new (NAUTILUS_TYPE_SIDEBAR_ROW,
+                                   "sidebar", self,
+                                   "label", title,
+                                   "section-type", section,
+                                   "place-type", NAUTILUS_SIDEBAR_ROW_GROUP,
+                                   NULL);
+    GtkWidget *template_child = gtk_list_box_row_get_child (GTK_LIST_BOX_ROW (row));
+    GtkWidget *container = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+    GtkWidget *label = gtk_label_new (title);
+
+    g_object_ref (template_child);
+    gtk_list_box_row_set_child (GTK_LIST_BOX_ROW (row), NULL);
+    gtk_box_append (GTK_BOX (container), template_child);
+    g_object_unref (template_child);
+    gtk_widget_set_visible (template_child, FALSE);
+    gtk_list_box_row_set_child (GTK_LIST_BOX_ROW (row), container);
+    gtk_list_box_row_set_selectable (GTK_LIST_BOX_ROW (row), FALSE);
+    gtk_list_box_row_set_activatable (GTK_LIST_BOX_ROW (row), FALSE);
+    gtk_widget_set_focusable (row, FALSE);
+    gtk_widget_add_css_class (label, "heading");
+    gtk_widget_set_hexpand (label, TRUE);
+    gtk_label_set_xalign (GTK_LABEL (label), 0);
+    gtk_box_append (GTK_BOX (box), label);
+
+    if (collapsible)
+    {
+        gboolean plex = section == NAUTILUS_SIDEBAR_SECTION_PLEX;
+        gboolean work = section == NAUTILUS_SIDEBAR_SECTION_BOOKMARKS;
+        gboolean expanded = plex ? self->plex_expanded :
+                            work ? self->work_expanded : self->disks_expanded;
+        GtkWidget *button = gtk_toggle_button_new ();
+        GtkWidget *arrow = gtk_image_new_from_icon_name (expanded ?
+                                                        "pan-down-symbolic" : "pan-end-symbolic");
+
+        gtk_label_set_text_with_mnemonic (GTK_LABEL (label), plex ? "_Plex" : work ? _("_Work") : _("_Disks"));
+        gtk_label_set_mnemonic_widget (GTK_LABEL (label), button);
+        gtk_box_append (GTK_BOX (box), arrow);
+        gtk_button_set_child (GTK_BUTTON (button), box);
+        gtk_widget_add_css_class (button, "flat");
+        gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (button), expanded);
+        gtk_accessible_update_property (GTK_ACCESSIBLE (button),
+                                         GTK_ACCESSIBLE_PROPERTY_LABEL, title, -1);
+        gtk_accessible_update_state (GTK_ACCESSIBLE (button),
+                                     GTK_ACCESSIBLE_STATE_EXPANDED, expanded, -1);
+        gtk_widget_set_tooltip_text (button, plex ? _("Show or hide Plex folders (Alt+P)") :
+                                     work ? _("Show or hide work bookmarks (Alt+L)") :
+                                     _("Show or hide disks (Alt+D)"));
+        g_object_set_data (G_OBJECT (button), "expanded-key",
+                           plex ? "sidebar-plex-expanded" : work ? "sidebar-work-expanded" : "sidebar-disks-expanded");
+        g_signal_connect (button, "toggled", G_CALLBACK (group_toggled), self);
+        gtk_box_append (GTK_BOX (container), button);
+        if (plex)
+        {
+            self->plex_toggle = button;
+        }
+        else if (work)
+        {
+            self->work_toggle = button;
+        }
+        else
+        {
+            self->disks_toggle = button;
+        }
+    }
+    else
+    {
+        gtk_widget_set_margin_start (box, 12);
+        gtk_widget_set_margin_end (box, 12);
+        gtk_widget_set_margin_top (box, 8);
+        gtk_widget_set_margin_bottom (box, 4);
+        gtk_box_append (GTK_BOX (container), box);
+    }
+    gtk_list_box_insert (GTK_LIST_BOX (self->list_box), row, -1);
+}
+
+static GHashTable *
+add_plex_places (NautilusSidebar *self)
+{
+    g_autofree char *filename = g_build_filename (g_get_user_config_dir (), "nautilus-codlab",
+                                                 "barra.ini", NULL);
+    g_autoptr (GKeyFile) config = g_key_file_new ();
+    g_auto (GStrv) groups = NULL;
+    GHashTable *locations = g_hash_table_new_full (g_file_hash, (GEqualFunc) g_file_equal,
+                                                  g_object_unref, NULL);
+
+    if (!g_key_file_load_from_file (config, filename, G_KEY_FILE_NONE, NULL))
+    {
+        return locations;
+    }
+    groups = g_key_file_get_groups (config, NULL);
+    for (guint i = 0; groups[i] != NULL && i < 64; i++)
+    {
+        g_autofree char *name = g_key_file_get_string (config, groups[i], "Name", NULL);
+        g_autofree char *uri = g_key_file_get_string (config, groups[i], "Uri", NULL);
+        g_autofree char *icon_name = g_key_file_get_string (config, groups[i], "Icon", NULL);
+        g_autoptr (GFile) location = NULL;
+        g_autoptr (GIcon) icon = NULL;
+        g_autofree char *path = NULL;
+
+        if (name == NULL || *name == '\0' || strpbrk (name, "\r\n") != NULL ||
+            uri == NULL || !g_str_has_prefix (uri, "file:///"))
+        {
+            continue;
+        }
+        location = g_file_new_for_uri (uri);
+        if (!g_file_is_native (location) || g_hash_table_contains (locations, location))
+        {
+            continue;
+        }
+        if (g_hash_table_size (locations) == 0)
+        {
+            add_sidebar_group (self, NAUTILUS_SIDEBAR_SECTION_PLEX, "Plex", TRUE);
+        }
+        path = g_file_get_path (location);
+        icon = g_themed_icon_new (icon_name != NULL && *icon_name != '\0' ?
+                                 icon_name : "folder-videos");
+        add_place (self, NAUTILUS_SIDEBAR_ROW_BUILT_IN, NAUTILUS_SIDEBAR_SECTION_PLEX,
+                   name, icon, NULL, uri, NULL, NULL, NULL, NULL, i, path);
+        g_hash_table_add (locations, g_steal_pointer (&location));
+    }
+    return locations;
+}
