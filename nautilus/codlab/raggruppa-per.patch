+/* CodLab (INC-3 «Nautilus potente»): raggruppamento della vista a elenco.
+ *
+ * GNOME Files non ha un «Raggruppa per»; Explorer sì. GTK 4.12+ però ha
+ * gia' le sezioni nelle liste (GtkSectionModel + header factory di
+ * GtkColumnView) e NautilusViewModel espone gia'
+ * nautilus_view_model_set_section_sorter(): qui vive solo la decizione di
+ * QUale gruppo prende un file (il «bucket»), l'ordine dei gruppi e le
+ * etichette tradotte delle intestazioni.
+ *
+ * Tre modi, come il menu «Raggruppa per» di Explorer:
+ *   tipo       Cartelle / Immagini / Video / Documenti / Audio / Altro
+ *   data       Oggi / Ieri / Ultima settimana / Ultimo mese / Più vecchi
+ *              (sulla data di modifica, a mezzanotte locale)
+ *   dimensione Grande (>= 100 MiB) / Media (>= 1 MiB) / Piccola
+ *
+ * Il rango e' l'ordine di visualizzazione (0 primo). Due sorter:
+ * uno sui NautilusViewItem per l'ordinamento globale (il gruppo PRIMA delle
+ * cartelle-prima e dell'ordinamento delle colonne, altrimenti le sezioni non
+ * restano contigue) e uno sui GtkTreeListRow per il section model di
+ * GtkSortListModel. Nessuna dipendenza nuova.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include <gtk/gtk.h>
+
+#include "nautilus-file.h"
+#include "nautilus-view-item.h"
+
+G_BEGIN_DECLS
+
+typedef enum
+{
+    NAUTILUS_CODELAB_GROUP_NESSUNO = 0,
+    NAUTILUS_CODELAB_GROUP_TIPO,
+    NAUTILUS_CODELAB_GROUP_DATA,
+    NAUTILUS_CODELAB_GROUP_DIMENSIONE,
+} NautilusCodlabGroupMode;
+
+/* "nessuno" (default, e qualunque valore sconosciuto), "tipo", "data",
+ * "dimensione" — i valori della chiave org.gnome.nautilus.codlab:
+ * raggruppa-per. Mai abortire su valori futuri o sporchi. */
+NautilusCodlabGroupMode nautilus_codlab_group_mode_from_string (const char *value);
+
+/* rango del gruppo del file nell'ordine di visualizzazione; un file NULL
+ * finisce nell'ULTIMO gruppo (mai un deref) */
+int nautilus_codlab_group_rank (NautilusCodlabGroupMode mode,
+                                NautilusFile           *file);
+
+/* etichetta tradotta dell'intestazione del gruppo di quel rango */
+const char *nautilus_codlab_group_label (NautilusCodlabGroupMode mode,
+                                         int                     rank);
+
+/* etichetta tradotta del gruppo di un item (per l'header factory) */
+const char *nautilus_codlab_group_item_label (NautilusCodlabGroupMode  mode,
+                                              NautilusViewItem        *item);
+
+/* sorter sui NautilusViewItem: gruppo prima di tutto il resto */
+GtkSorter *nautilus_codlab_group_sorter_new (NautilusCodlabGroupMode mode);
+
+/* sorter sui GtkTreeListRow: per nautilus_view_model_set_section_sorter */
+GtkSorter *nautilus_codlab_group_section_sorter_new (NautilusCodlabGroupMode mode);
+
+G_END_DECLS
