diff -ruN a/src/nautilus-codlab-grouping.c b/src/nautilus-codlab-grouping.c
--- a/src/nautilus-codlab-grouping.c	1970-01-01 01:00:00.000000000 +0100
+++ b/src/nautilus-codlab-grouping.c	2026-11-01 07:15:46.084135757 +0100
@@ -0,0 +1,389 @@
+/* CodLab (INC-3 «Nautilus potente»): raggruppa la vista a elenco.
+ * Vedi nautilus-codlab-grouping.h per il disegno.
+ *
+ */
+
+#include <glib/gi18n.h>
+
+#include "nautilus-codlab-grouping.h"
+
+#include "nautilus-file.h"
+#include "nautilus-view-item.h"
+
+/* soglie del raggruppamento per dimensione, come da PIANO INC-3:
+ * grande/media/piccola. 100 MiB e 1 MiB, soglie tonde e dichiarate. */
+#define CODELAB_GRANDE_BYTES (100ull * 1024 * 1024)
+#define CODELAB_MEDIA_BYTES (1ull * 1024 * 1024)
+
+/* ranghi dei gruppi: l'ordine qui e' l'ordine di visualizzazione */
+enum
+{
+    GRUPPO_TIPO_CARTELLE = 0,
+    GRUPPO_TIPO_IMMAGINI,
+    GRUPPO_TIPO_VIDEO,
+    GRUPPO_TIPO_DOCUMENTI,
+    GRUPPO_TIPO_AUDIO,
+    GRUPPO_TIPO_ALTRO,
+    N_GRUPPI_TIPO,
+};
+
+enum
+{
+    GRUPPO_DATA_OGGI = 0,
+    GRUPPO_DATA_IERI,
+    GRUPPO_DATA_SETTIMANA,
+    GRUPPO_DATA_MESE,
+    GRUPPO_DATA_VECCHI,
+    N_GRUPPI_DATA,
+};
+
+enum
+{
+    GRUPPO_DIM_GRANDE = 0,
+    GRUPPO_DIM_MEDIA,
+    GRUPPO_DIM_PICCOLA,
+    N_GRUPPI_DIM,
+};
+
+NautilusCodlabGroupMode
+nautilus_codlab_group_mode_from_string (const char *value)
+{
+    if (g_strcmp0 (value, "tipo") == 0)
+    {
+        return NAUTILUS_CODELAB_GROUP_TIPO;
+    }
+    if (g_strcmp0 (value, "data") == 0)
+    {
+        return NAUTILUS_CODELAB_GROUP_DATA;
+    }
+    if (g_strcmp0 (value, "dimensione") == 0)
+    {
+        return NAUTILUS_CODELAB_GROUP_DIMENSIONE;
+    }
+
+    /* "nessuno", valori sconosciuti, NULL: niente raggruppamento */
+    return NAUTILUS_CODELAB_GROUP_NESSUNO;
+}
+
+/* Documenti: tutto cio' che un utente legge, non guarda e non ascolta.
+ * Elenco esplicito per non classificare male gli application/ strani. */
+static gboolean
+mime_e_documento (const char *mime)
+{
+    static const char *esatti[] =
+    {
+        "application/pdf",
+        "application/rtf",
+        "application/msword",
+        "application/epub+zip",
+        "application/json",
+        "application/xml",
+        "application/xhtml+xml",
+        "text/html",
+        NULL,
+    };
+
+    if (mime == NULL)
+    {
+        return FALSE;
+    }
+
+    if (g_str_has_prefix (mime, "text/"))
+    {
+        return TRUE;
+    }
+
+    for (int i = 0; esatti[i] != NULL; i++)
+    {
+        if (g_strcmp0 (mime, esatti[i]) == 0)
+        {
+            return TRUE;
+        }
+    }
+
+    return (g_str_has_prefix (mime, "application/vnd.oasis.opendocument.") ||
+            g_str_has_prefix (mime, "application/vnd.openxmlformats-officedocument.") ||
+            g_str_has_prefix (mime, "application/vnd.ms-") ||
+            g_str_has_prefix (mime, "application/vnd.oasis.opendocument"));
+}
+
+static int
+rank_tipo (NautilusFile *file)
+{
+    const char *mime;
+
+    if (file == NULL)
+    {
+        return GRUPPO_TIPO_ALTRO;
+    }
+
+    if (nautilus_file_is_directory (file))
+    {
+        return GRUPPO_TIPO_CARTELLE;
+    }
+
+    mime = nautilus_file_get_mime_type (file);
+    if (mime == NULL)
+    {
+        return GRUPPO_TIPO_ALTRO;
+    }
+
+    if (g_str_has_prefix (mime, "image/"))
+    {
+        return GRUPPO_TIPO_IMMAGINI;
+    }
+    if (g_str_has_prefix (mime, "video/"))
+    {
+        return GRUPPO_TIPO_VIDEO;
+    }
+    if (mime_e_documento (mime))
+    {
+        return GRUPPO_TIPO_DOCUMENTI;
+    }
+    if (g_str_has_prefix (mime, "audio/"))
+    {
+        return GRUPPO_TIPO_AUDIO;
+    }
+
+    return GRUPPO_TIPO_ALTRO;
+}
+
+static GDateTime *
+mezzanotte_di (GDateTime *t)
+{
+    return g_date_time_new_local (g_date_time_get_year (t),
+                                  g_date_time_get_month (t),
+                                  g_date_time_get_day_of_month (t),
+                                  0, 0, 0.0);
+}
+
+static int
+rank_data (NautilusFile *file)
+{
+    time_t mtime;
+    g_autoptr (GDateTime) t_file = NULL;
+    g_autoptr (GDateTime) t_adesso = NULL;
+    g_autoptr (GDateTime) notte_file = NULL;
+    g_autoptr (GDateTime) notte_oggi = NULL;
+    glong giorni_fa;
+
+    if (file == NULL)
+    {
+        return GRUPPO_DATA_VECCHI;
+    }
+
+    mtime = nautilus_file_get_mtime (file);
+    if (mtime == (time_t) 0 || mtime == (time_t) -1)
+    {
+        return GRUPPO_DATA_VECCHI;
+    }
+
+    t_file = g_date_time_new_from_unix_local ((gint64) mtime);
+    t_adesso = g_date_time_new_now_local ();
+    if (t_file == NULL || t_adesso == NULL)
+    {
+        return GRUPPO_DATA_VECCHI;
+    }
+
+    notte_oggi = mezzanotte_di (t_adesso);
+
+    /* oggi (o, strano ma vero, nel futuro): primo gruppo */
+    if (g_date_time_difference (t_file, notte_oggi) >= 0)
+    {
+        return GRUPPO_DATA_OGGI;
+    }
+
+    notte_file = mezzanotte_di (t_file);
+    giorni_fa = (gint) (-g_date_time_difference (notte_file, notte_oggi) / G_TIME_SPAN_DAY);
+    if (giorni_fa <= 1)
+    {
+        return GRUPPO_DATA_IERI;
+    }
+    if (giorni_fa <= 7)
+    {
+        return GRUPPO_DATA_SETTIMANA;
+    }
+    if (giorni_fa <= 31)
+    {
+        return GRUPPO_DATA_MESE;
+    }
+
+    return GRUPPO_DATA_VECCHI;
+}
+
+static int
+rank_dimensione (NautilusFile *file)
+{
+    if (file == NULL)
+    {
+        return GRUPPO_DIM_PICCOLA;
+    }
+
+    /* nautilus_file_get_size torna 4096 per le cartelle e la dimensione
+     * nota per i file: per il raggruppamento va bene cosi' (le cartelle
+     * finiscono nella sezione Piccola o dove la loro dimensione le mette) */
+    if (nautilus_file_get_size (file) >= CODELAB_GRANDE_BYTES)
+    {
+        return GRUPPO_DIM_GRANDE;
+    }
+    if (nautilus_file_get_size (file) >= CODELAB_MEDIA_BYTES)
+    {
+        return GRUPPO_DIM_MEDIA;
+    }
+
+    return GRUPPO_DIM_PICCOLA;
+}
+
+int
+nautilus_codlab_group_rank (NautilusCodlabGroupMode  mode,
+                            NautilusFile            *file)
+{
+    switch (mode)
+    {
+        case NAUTILUS_CODELAB_GROUP_TIPO:
+        {
+            return rank_tipo (file);
+        }
+
+        case NAUTILUS_CODELAB_GROUP_DATA:
+        {
+            return rank_data (file);
+        }
+
+        case NAUTILUS_CODELAB_GROUP_DIMENSIONE:
+        {
+            return rank_dimensione (file);
+        }
+
+        case NAUTILUS_CODELAB_GROUP_NESSUNO:
+        break;
+    }
+
+    return 0;
+}
+
+const char *
+nautilus_codlab_group_label (NautilusCodlabGroupMode  mode,
+                             int                      rank)
+{
+    /* C_() non e' una costante di compilatore: switch, non array statico.
+     * Contesto "group heading" su TUTTE le stringhe: niente collisioni
+     * con gli msgid gia' presenti (lezione it.po di INC-1/INC-2). */
+    switch (mode)
+    {
+        case NAUTILUS_CODELAB_GROUP_TIPO:
+        {
+            switch (rank)
+            {
+                case GRUPPO_TIPO_CARTELLE:    return C_ ("group heading", "Folders");
+                case GRUPPO_TIPO_IMMAGINI:    return C_ ("group heading", "Images");
+                case GRUPPO_TIPO_VIDEO:       return C_ ("group heading", "Videos");
+                case GRUPPO_TIPO_DOCUMENTI:   return C_ ("group heading", "Documents");
+                case GRUPPO_TIPO_AUDIO:       return C_ ("group heading", "Audio");
+                default:                      return C_ ("group heading", "Other");
+            }
+        }
+
+        case NAUTILUS_CODELAB_GROUP_DATA:
+        {
+            switch (rank)
+            {
+                case GRUPPO_DATA_OGGI:      return C_ ("group heading", "Today");
+                case GRUPPO_DATA_IERI:      return C_ ("group heading", "Yesterday");
+                case GRUPPO_DATA_SETTIMANA: return C_ ("group heading", "Last week");
+                case GRUPPO_DATA_MESE:      return C_ ("group heading", "Last month");
+                default:                    return C_ ("group heading", "Older");
+            }
+        }
+
+        case NAUTILUS_CODELAB_GROUP_DIMENSIONE:
+        {
+            switch (rank)
+            {
+                case GRUPPO_DIM_GRANDE:  return C_ ("group heading", "Large");
+                case GRUPPO_DIM_MEDIA:   return C_ ("group heading", "Medium");
+                default:                 return C_ ("group heading", "Small");
+            }
+        }
+
+        case NAUTILUS_CODELAB_GROUP_NESSUNO:
+        break;
+    }
+
+    return "";
+}
+
+const char *
+nautilus_codlab_group_item_label (NautilusCodlabGroupMode  mode,
+                                  NautilusViewItem        *item)
+{
+    NautilusFile *file;
+
+    if (item == NULL)
+    {
+        return "";
+    }
+
+    file = nautilus_view_item_get_file (item);
+    if (file == NULL)
+    {
+        return "";
+    }
+
+    return nautilus_codlab_group_label (mode, nautilus_codlab_group_rank (mode, file));
+}
+
+static int
+confronta_item (gconstpointer a,
+                gconstpointer b,
+                gpointer      user_data)
+{
+    NautilusCodlabGroupMode mode = (NautilusCodlabGroupMode) GPOINTER_TO_INT (user_data);
+    int ra = nautilus_codlab_group_rank (mode,
+                                         nautilus_view_item_get_file (NAUTILUS_VIEW_ITEM ((gpointer) a)));
+    int rb = nautilus_codlab_group_rank (mode,
+                                         nautilus_view_item_get_file (NAUTILUS_VIEW_ITEM ((gpointer) b)));
+
+    if (ra != rb)
+    {
+        return (ra < rb) ? -1 : 1;
+    }
+
+    return GTK_ORDERING_EQUAL;
+}
+
+static int
+confronta_riga (gconstpointer a,
+                gconstpointer b,
+                gpointer      user_data)
+{
+    NautilusCodlabGroupMode mode = (NautilusCodlabGroupMode) GPOINTER_TO_INT (user_data);
+    /* righe del tree model:GtkTreeListRow -> NautilusViewItem -> file; gli
+     * item tornati da gtk_tree_list_row_get_item sono nostri: unref subito */
+    g_autoptr (NautilusViewItem) ia = gtk_tree_list_row_get_item (GTK_TREE_LIST_ROW ((gpointer) a));
+    g_autoptr (NautilusViewItem) ib = gtk_tree_list_row_get_item (GTK_TREE_LIST_ROW ((gpointer) b));
+    int ra = (ia != NULL) ?
+             nautilus_codlab_group_rank (mode, nautilus_view_item_get_file (ia)) : 0;
+    int rb = (ib != NULL) ?
+             nautilus_codlab_group_rank (mode, nautilus_view_item_get_file (ib)) : 0;
+
+    if (ra != rb)
+    {
+        return (ra < rb) ? -1 : 1;
+    }
+
+    return GTK_ORDERING_EQUAL;
+}
