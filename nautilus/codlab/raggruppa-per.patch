+nautilus_codlab_group_sorter_new (NautilusCodlabGroupMode mode)
+{
+    return GTK_SORTER (gtk_custom_sorter_new (confronta_item, GINT_TO_POINTER (mode), NULL));
+}
+
+GtkSorter *
+nautilus_codlab_group_section_sorter_new (NautilusCodlabGroupMode mode)
+{
+    return GTK_SORTER (gtk_custom_sorter_new (confronta_riga, GINT_TO_POINTER (mode), NULL));
+}
