+/* -------------------------------------------------------- Cambia icona */
+
+#ifdef CODLAB_INC4B
+/* INC-4b, spento: «Cambia icona» (vedi la testata del file) */
+static void
+icona_cambiata (GtkEditable *voce, gpointer dato)
+{
+    DatiDialogo *d = dato;
+    const char *nome = gtk_editable_get_text (voce);
+    GtkIconTheme *tema = gtk_icon_theme_get_for_display (
