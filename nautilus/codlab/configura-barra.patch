+    {
+        gtk_image_set_from_icon_name (GTK_IMAGE (d->anteprima),
+                                      "image-missing-symbolic");
+    }
+}
+
+static gboolean
+conferma_icona (DatiDialogo *d)
+{
+    const char *testo = gtk_editable_get_text (GTK_EDITABLE (d->voce_icona));
+
+    if (d->indice < 0 || (guint) d->indice >= d->st->ini->len)
+    {
+        return FALSE;
+    }
+    SezioneIni *s = g_ptr_array_index (d->st->ini, d->indice);
