+static void
+apri_dialogo_icona (StatoConfig *st, int indice)
+{
+    SezioneIni *s = g_ptr_array_index (st->ini, indice);
+    GtkWidget *contenuto = NULL;
+    DatiDialogo *d = g_new0 (DatiDialogo, 1);
+    AdwDialog *dialogo = guscio_dialogo (_("Change icon"), _("Confirm"),
+                                          conferma_icona, d, &contenuto);
+    GtkWidget *riga = adw_entry_row_new ();
+    GtkWidget *anteprima = gtk_image_new_from_icon_name (
+        s->icona != NULL && *s->icona != '\0' ? s->icona : "image-missing-symbolic");
+
+    d->st = st;
+    d->plex = TRUE;
+    d->indice = indice;
+    d->voce_icona = riga;
+    d->anteprima = anteprima;
+
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga), _("Icon"));
+    gtk_editable_set_text (GTK_EDITABLE (riga), s->icona != NULL ? s->icona : "");
+    gtk_image_set_pixel_size (GTK_IMAGE (anteprima), 48);
+    gtk_widget_set_valign (anteprima, GTK_ALIGN_START);
+    /* l'anteprima segue la scrittura: si vede SUBITO se il nome esiste */
+    g_signal_connect (riga, "changed", G_CALLBACK (icona_cambiata), d);
+    gtk_box_append (GTK_BOX (contenuto), riga);
+    gtk_box_append (GTK_BOX (contenuto), anteprima);
+    adw_dialog_present (dialogo, st->finestra);
+}
