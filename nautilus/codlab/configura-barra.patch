+/* nautilus-sidebar-config.h — CodLab (INC-4): finestra «Configura»
+ * per i gruppi della barra laterale (Lavoro/Plex).
+ *
+ * Il modello dati sono i due file che la patch «blocchi-barra» legge
+ * già oggi: ~/.config/nautilus-codlab/barra.ini (gruppo Plex, formato
+ * invariato) e ~/.config/gtk-3.0/bookmarks (gruppo Lavoro). Le scritture
+ * sono atomiche (g_file_set_contents: file temporaneo + rename) e
+ * lasciano accanto a ogni file la copia di prima (<file>.bak).
+ */
+#pragma once
+
+#include <gtk/gtk.h>
+
+G_BEGIN_DECLS
+
+/* Crea la finestra «Configura i gruppi della barra», transient per il
+ * GtkRoot del widget genitore (la barra laterale). Restituisce un riferimento
+ * nuovo: il chiamante lo tiene (puntatore debole consigliato) e la finestra
+ * si distrugge da sola alla chiusura. */
+GtkWidget *nautilus_sidebar_config_new (GtkWidget *genitore);
+
+G_END_DECLS
