 }
 
+/* CodLab (INC-4): stessa guardia per-chiave per gruppi-personalizzati. La
+ * finestra «Configura» scrive barra.ini e i segnalibri con uno schema
+ * vecchio davanti (1.9/1.8.1 senza la chiave): la scrittura riesce, la
+ * chiave resta ferma, nessun GLib-GIO-ERROR. */
+gboolean
+nautilus_codlab_preferences_has_gruppi_personalizzati (void)
+{
+    return (nautilus_codlab_preferences != NULL && codlab_schema != NULL &&
+            g_settings_schema_has_key (codlab_schema,
+                                       NAUTILUS_CODELAB_PREFERENCES_GRUPPI_PERSONALIZZATI));
+}
+
+gboolean
+nautilus_codlab_preferences_get_gruppi_personalizzati (void)
+{
+    if (!nautilus_codlab_preferences_has_gruppi_personalizzati ())
+    {
+        return FALSE;
+    }
+    return g_settings_get_boolean (nautilus_codlab_preferences,
+                                   NAUTILUS_CODELAB_PREFERENCES_GRUPPI_PERSONALIZZATI);
+}
+
+void
+nautilus_codlab_preferences_set_gruppi_personalizzati (gboolean valore)
+{
+    if (!nautilus_codlab_preferences_has_gruppi_personalizzati ())
+    {
+        return;
+    }
+    g_settings_set_boolean (nautilus_codlab_preferences,
+                            NAUTILUS_CODELAB_PREFERENCES_GRUPPI_PERSONALIZZATI,
+                            valore);
+}
