+/* ------------------------------------------------- selettore cartelle */
+
+static void
+cartella_accettata (NautilusFileChooser *selettore,
+                    GList               *percorsi,
+                    GtkFileFilter       *filtro,
+                    gpointer             dato)
+{
+    DatiDialogo *d = dato;
+    GFile *cartella = percorsi != NULL ? g_object_ref (percorsi->data) : NULL;
+    g_autofree char *uri = NULL;
+    g_autofree char *nome = NULL;
+
+    /* TUTTO il lavoro PRIMA di chiudere il selettore, per due motivi
+     * misurati (02.11): la sidebar INTERNA del selettore monitora
+     * barra.ini come quella principale, e chiudere prima lasciava la
+     * voce scritta con la barra VERA mai aggiornata (il monitor
+     * condiviso partiva con la finestra); e i dati d vivono sul
+     * selettore: dopo gtk_window_destroy resterebbero appesi. */
+    if (cartella != NULL)
+    {
+        uri = g_file_get_uri (cartella);
+        if (d->voce_cartella != NULL)
+        {
+            /* «Sfoglia…» della finestra Nuova voce: riempie il campo */
+            gtk_editable_set_text (GTK_EDITABLE (d->voce_cartella), uri);
+        }
+        else
+        {
+            /* «Aggiungi cartella…» diretto: aggiunge la voce adesso */
+            nome = etichetta_uri (uri);
+            if (uri_gia_presente (d->st, d->plex, uri))
+            {
+                avvisa (d->st, _("An entry for this folder already exists."));
+            }
+            else if (d->plex && d->st->ini->len >= SEZIONI_BARRA)
+            {
+                avvisa (d->st, _("Too many entries in the Plex group (64 at most)."));
+            }
+            else
+            {
+                aggiungi_voce (d->st, d->plex, cartella, nome, "");
+                aggiorna_sottotitolo (d->st);
+            }
+        }
+        g_object_unref (cartella);
+    }
+    gtk_window_destroy (GTK_WINDOW (selettore));
+}
+
+/* Il selettore di cartelle è quello DI NAUTILUS (AdwWindow, nessuna API
+ * deprecata): «accepted» consegna la cartella scelta. */
+static void
+apri_selettore_cartella (StatoConfig *st, gboolean plex, GtkWidget *destinazione)
+{
+    NautilusFileChooser *selettore =
+        nautilus_file_chooser_new (NAUTILUS_MODE_OPEN_FOLDER);
+    DatiDialogo *d = g_new0 (DatiDialogo, 1);
+
+    d->st = st;
+    d->plex = plex;
+    d->voce_cartella = destinazione;
+
+    gtk_window_set_title (GTK_WINDOW (selettore), _("Choose a folder"));
+    nautilus_file_chooser_set_accept_label (selettore, _("Select"));
+    /* si apre su Home: e' da lì che si naviga (niente campo percorso
+     * digitabile nel selettore nuovo di Nautilus 51). R1 (revisione del
+     * 02.11): il setter prende un riferimento suo (g_object_ref)
+     * e NON consuma quello del chiamante — il GFile nudo passato prima
+     * perdeva un riferimento a ogni «Nuova voce → Sfoglia»: g_autoptr
+     * rilascia il nostro alla fine della funzione */
+    g_autoptr (GFile) partenza = g_file_new_for_path (g_get_home_dir ());
+
+    nautilus_file_chooser_set_starting_location (selettore, partenza);
+    gtk_window_set_modal (GTK_WINDOW (selettore), TRUE);
+    gtk_window_set_transient_for (GTK_WINDOW (selettore),
+                                  GTK_WINDOW (st->finestra));
+    g_object_set_data_full (G_OBJECT (selettore), "dati", d, dati_dialogo_free);
+    g_signal_connect (selettore, "accepted",
+                      G_CALLBACK (cartella_accettata), d);
+    /* ALLA distruzione del selettore (accetto o annullo, non importa):
+     * la sua sidebar muore col relativo watch inotify CONDIVISO con
+     * quello della barra principale, che resta sorda — si arma subito il
+     * monitor di riserva (watch nuovo, mai piu' cancellato) */
+    g_signal_connect (selettore, "destroy",
+                      G_CALLBACK (arma_monitor_barra), NULL);
+    gtk_window_present (GTK_WINDOW (selettore));
+}
+
+/* ------------------------------------------------- finestra Nuova voce */
+
+static gboolean
+conferma_nuova (DatiDialogo *d)
+{
+    const char *nome = gtk_editable_get_text (GTK_EDITABLE (d->voce_nome));
+    const char *cartella = gtk_editable_get_text (GTK_EDITABLE (d->voce_cartella));
+    const char *icona = d->voce_icona != NULL ?
+                        gtk_editable_get_text (GTK_EDITABLE (d->voce_icona)) : "";
+    g_autoptr (GFile) file = NULL;
+
+    if (nome == NULL || *nome == '\0' || strpbrk (nome, "\r\n") != NULL ||
+        cartella == NULL || *cartella == '\0')
+    {
+        return FALSE;
+    }
+    /* accetta sia un percorso sia un file:/// URI, come li incolla l'utente */
+    file = strstr (cartella, "://") != NULL ?
+           g_file_new_for_uri (cartella) : g_file_new_for_path (cartella);
+    if (g_file_query_file_type (file, G_FILE_QUERY_INFO_NONE, NULL) !=
+        G_FILE_TYPE_DIRECTORY)
+    {
+        avvisa (d->st, _("The folder does not exist."));
+        return FALSE;
+    }
+    g_autofree char *uri = g_file_get_uri (file);
+
+    if (uri_gia_presente (d->st, d->plex, uri))
+    {
+        avvisa (d->st, _("An entry for this folder already exists."));
+        return FALSE;
+    }
+    if (d->plex && d->st->ini->len >= SEZIONI_BARRA)
+    {
+        avvisa (d->st, _("Too many entries in the Plex group (64 at most)."));
+        return FALSE;
+    }
+    if (!aggiungi_voce (d->st, d->plex, file, nome, icona))
+    {
+        return FALSE;
+    }
+    aggiorna_sottotitolo (d->st);
+    return TRUE;
+}
+
+static void
+su_sfoglia (GtkButton *pulsante, gpointer dato)
+{
+    DatiDialogo *d = dato;
+
+    apri_selettore_cartella (d->st, d->plex, d->voce_cartella);
+}
+
+static void
+apri_dialogo_nuova (StatoConfig *st, gboolean plex)
+{
+    GtkWidget *contenuto = NULL;
+    DatiDialogo *d = g_new0 (DatiDialogo, 1);
+    AdwDialog *dialogo = guscio_dialogo (_("New entry"), _("Create"),
+                                          conferma_nuova, d, &contenuto);
+    GtkWidget *riga_nome = adw_entry_row_new ();
+    GtkWidget *riga_cartella = adw_entry_row_new ();
+    GtkWidget *sfoglia = gtk_button_new_with_label (_("Browse…"));
+    GtkWidget *riga_icona = plex ? adw_entry_row_new () : NULL;
+
+    d->st = st;
+    d->plex = plex;
+    d->indice = -1;
+    d->voce_nome = riga_nome;
+    d->voce_cartella = riga_cartella;
+    d->voce_icona = riga_icona;
+
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga_nome), _("Name"));
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga_cartella), _("Folder"));
+    gtk_box_append (GTK_BOX (contenuto), riga_nome);
+    gtk_widget_add_css_class (sfoglia, "flat");
+    adw_entry_row_add_suffix (ADW_ENTRY_ROW (riga_cartella), sfoglia);
+    g_object_set_data_full (G_OBJECT (sfoglia), "dati", d, NULL);
+    g_signal_connect (sfoglia, "clicked", G_CALLBACK (su_sfoglia), d);
+    gtk_box_append (GTK_BOX (contenuto), riga_cartella);
+    if (riga_icona != NULL)
+    {
+        adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga_icona), _("Icon"));
+        gtk_editable_set_text (GTK_EDITABLE (riga_icona), "folder-videos");
+        gtk_box_append (GTK_BOX (contenuto), riga_icona);
+    }
+    adw_dialog_present (dialogo, st->finestra);
+}
+
+/* ------------------------------------------------ costruzione delle liste */
+
+static void
+riga_attivata (GtkListBox *box, GtkListBoxRow *riga, gpointer dato)
+{
+    StatoConfig *st = dato;
+    gboolean plex = box == GTK_LIST_BOX (st->lista_plex);
+
+    if (riga == NULL)
+    {
+        return;
+    }
+    su_selezione (box, riga, st);
+    apri_dialogo_rinomina (st, plex,
+                           GPOINTER_TO_INT (g_object_get_data (G_OBJECT (riga), "indice")));
+}
+
+static void
+vuota_lista (GtkWidget *lista)
+{
+    GtkListBoxRow *figlio = gtk_list_box_get_row_at_index (GTK_LIST_BOX (lista), 0);
+
+    while (figlio != NULL)
+    {
+        gtk_list_box_remove (GTK_LIST_BOX (lista), GTK_WIDGET (figlio));
+        figlio = gtk_list_box_get_row_at_index (GTK_LIST_BOX (lista), 0);
+    }
+}
+
+static void
+ricostruisci_lavoro (StatoConfig *st)
+{
+    vuota_lista (st->lista_lavoro);
+    st->sel_lavoro = NULL;
+    for (guint i = 0; i < st->segnalibri->len; i++)
+    {
+        RigaSegnalibro *r = g_ptr_array_index (st->segnalibri, i);
+        GtkWidget *riga = adw_action_row_new ();
+        GtkWidget *icona = gtk_image_new_from_icon_name ("folder-symbolic");
+        g_autofree char *sottotitolo = r->grezza != NULL ?
+                                       g_strdup (r->grezza) : etichetta_uri (r->uri);
+        const char *titolo = r->grezza != NULL ? r->grezza : r->etichetta;
+
+        if (r->grezza != NULL)
+        {
+            adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga), titolo);
+        }
+        else if (*r->etichetta == '\0')
+        {
+            adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga), sottotitolo);
+        }
+        else
+        {
+            adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga), titolo);
+        }
+        adw_action_row_set_subtitle (ADW_ACTION_ROW (riga), sottotitolo);
+        adw_action_row_add_prefix (ADW_ACTION_ROW (riga), icona);
+        g_object_set_data (G_OBJECT (riga), "indice", GINT_TO_POINTER (i));
+        gtk_list_box_append (GTK_LIST_BOX (st->lista_lavoro), riga);
+    }
+    if (st->segnalibri->len == 0)
+    {
+        GtkWidget *vuota = gtk_label_new (_("No entries"));
+
+        gtk_widget_add_css_class (vuota, "dim-label");
+        gtk_list_box_append (GTK_LIST_BOX (st->lista_lavoro), vuota);
+    }
+}
+
+static void
+ricostruisci_plex (StatoConfig *st)
+{
+    vuota_lista (st->lista_plex);
+    st->sel_plex = NULL;
+    /* le sezioni che la barra mostra; le altre restano nel file, intatte */
+    for (guint i = 0; i < st->ini->len && i < SEZIONI_BARRA; i++)
+    {
+        SezioneIni *s = g_ptr_array_index (st->ini, i);
+
+        if (!s->valida)
+        {
+            continue;
+        }
+        GtkWidget *riga = adw_action_row_new ();
+        const char *nome_icona = s->icona != NULL && *s->icona != '\0' ?
+                                 s->icona : "folder-videos";
+        GtkWidget *icona = gtk_image_new_from_icon_name (nome_icona);
+        g_autofree char *sottotitolo = etichetta_uri (s->uri);
+
+        adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga), s->nome);
+        adw_action_row_set_subtitle (ADW_ACTION_ROW (riga), sottotitolo);
+        adw_action_row_add_prefix (ADW_ACTION_ROW (riga), icona);
+        g_object_set_data (G_OBJECT (riga), "indice", GINT_TO_POINTER (i));
+        gtk_list_box_append (GTK_LIST_BOX (st->lista_plex), riga);
+    }
+    if (st->ini->len == 0)
+    {
+        GtkWidget *vuota = gtk_label_new (_("No entries"));
+
+        gtk_widget_add_css_class (vuota, "dim-label");
+        gtk_list_box_append (GTK_LIST_BOX (st->lista_plex), vuota);
+    }
+}
+
+/* -------------------------------------------------- azioni dei bottoni */
+
+static void
+su_aggiungi_cartella (GtkButton *pulsante, gpointer dato)
+{
+    StatoConfig *st = dato;
+    gboolean plex = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (pulsante), "plex"));
+
+    apri_selettore_cartella (st, plex, NULL);
+}
+
+static void
+su_nuova_voce (GtkButton *pulsante, gpointer dato)
+{
+    StatoConfig *st = dato;
+    gboolean plex = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (pulsante), "plex"));
+
+    apri_dialogo_nuova (st, plex);
+}
+
+static void
+su_rinomina (GtkButton *pulsante, gpointer dato)
+{
+    StatoConfig *st = dato;
+    GtkListBoxRow *riga = st->sel_plex != NULL ? st->sel_plex : st->sel_lavoro;
+
+    if (riga == NULL)
+    {
+        return;
+    }
+    apri_dialogo_rinomina (st, st->sel_plex != NULL,
+                           GPOINTER_TO_INT (g_object_get_data (G_OBJECT (riga), "indice")));
+}
+
+#ifdef CODLAB_INC4B
+/* INC-4b, spenti: i gestori dei tre bottoni (vedi la testata del file) */
+static void
+su_icona (GtkButton *pulsante, gpointer dato)
+{
+    StatoConfig *st = dato;
+
+    if (st->sel_plex == NULL)
+    {
+        return;
+    }
+    apri_dialogo_icona (st,
+                        GPOINTER_TO_INT (g_object_get_data (G_OBJECT (st->sel_plex),
+                                                            "indice")));
+}
+
+static void
+su_su (GtkButton *pulsante, gpointer dato)
+{
+    sposta (dato, -1);
+}
+
+static void
+su_giu (GtkButton *pulsante, gpointer dato)
+{
+    sposta (dato, +1);
+}
+#endif
+
+/* -------------------------------------------------------- la finestra */
+
+static GtkWidget *
+gruppo_finestra (StatoConfig *st, const char *titolo, gboolean plex)
+{
+    GtkWidget *casella = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+    GtkWidget *testata = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+    GtkWidget *etichetta = gtk_label_new (titolo);
+    GtkWidget *aggiungi = gtk_button_new_with_label (_("Add folder…"));
+    GtkWidget *nuova = gtk_button_new_with_label (_("New entry…"));
+    GtkWidget *lista = gtk_list_box_new ();
+
+    gtk_widget_add_css_class (etichetta, "heading");
+    gtk_widget_set_halign (etichetta, GTK_ALIGN_START);
+    gtk_widget_set_hexpand (etichetta, TRUE);
+    gtk_widget_set_valign (etichetta, GTK_ALIGN_CENTER);
+    gtk_widget_add_css_class (lista, "boxed-list");
+    gtk_list_box_set_selection_mode (GTK_LIST_BOX (lista), GTK_SELECTION_SINGLE);
+    /* il clic SINGOLO seleziona (per Rinomina, che agisce sulla selezione;
+     * con INC-4b anche Sposta e Icona); il DOPPIO clic apre il rinomina:
+     * come le liste di configurazione di GNOME, non come la barra dei posti */
+    gtk_list_box_set_activate_on_single_click (GTK_LIST_BOX (lista), FALSE);
+    g_object_set_data (G_OBJECT (aggiungi), "plex", GINT_TO_POINTER (plex ? 1 : 0));
+    g_object_set_data (G_OBJECT (nuova), "plex", GINT_TO_POINTER (plex ? 1 : 0));
+    g_signal_connect (aggiungi, "clicked", G_CALLBACK (su_aggiungi_cartella), st);
+    g_signal_connect (nuova, "clicked", G_CALLBACK (su_nuova_voce), st);
+    g_signal_connect (lista, "row-selected", G_CALLBACK (su_selezione), st);
+    g_signal_connect (lista, "row-activated", G_CALLBACK (riga_attivata), st);
+
+    gtk_box_append (GTK_BOX (testata), etichetta);
+    gtk_box_append (GTK_BOX (testata), aggiungi);
+    gtk_box_append (GTK_BOX (testata), nuova);
+    gtk_box_append (GTK_BOX (casella), testata);
+    gtk_box_append (GTK_BOX (casella), lista);
+
+    if (plex)
+    {
+        st->lista_plex = lista;
+    }
+    else
+    {
+        st->lista_lavoro = lista;
+    }
+    return casella;
+}
+
+static void
+stato_free (gpointer dato)
+{
+    StatoConfig *st = dato;
+
+    g_ptr_array_unref (st->ini);
+    g_ptr_array_unref (st->segnalibri);
+    g_key_file_unref (st->kf_lettura);
+    g_clear_pointer (&st->ini_letto, g_bytes_unref);
+    g_clear_pointer (&st->seg_letto, g_bytes_unref);
+    g_clear_object (&st->btn_rinomina);
+#ifdef CODLAB_INC4B
+    g_clear_object (&st->btn_icona);
+    g_clear_object (&st->btn_su);
+    g_clear_object (&st->btn_giu);
+#endif
+    g_free (st);
+}
+
+/* Escape chiude la finestra (HIG): serve anche alle prove dell'isola, dove
+ * il driver manda l'Escape di chiusura quando la modale e' ancora aperta */
+static gboolean
+su_tasto_config (GtkEventControllerKey *controller,
+                 guint                  keyval,
+                 guint                  keycode,
+                 GdkModifierType        state,
+                 gpointer               dato)
+{
+    if (keyval == GDK_KEY_Escape)
+    {
+        gtk_window_close (GTK_WINDOW (dato));
+        return TRUE;
+    }
+    return FALSE;
+}
+
+GtkWidget *
+nautilus_sidebar_config_new (GtkWidget *genitore)
+{
+    StatoConfig *st = g_new0 (StatoConfig, 1);
+    GtkWidget *finestra = adw_window_new ();
+    GtkWidget *vista = adw_toolbar_view_new ();
+    GtkWidget *testa = adw_header_bar_new ();
+    GtkWidget *titolo = adw_window_title_new (_("Configure sidebar groups"),
+                                              _(SOTTOTITOLO_CONFIGURA));
+    GtkWidget *scorsoio = gtk_scrolled_window_new ();
+    GtkWidget *morsetto = adw_clamp_new ();
+    GtkWidget *colonna = gtk_box_new (GTK_ORIENTATION_VERTICAL, 24);
+    GtkWidget *azione = gtk_action_bar_new ();
+    GtkWidget *gruppo_dischi;
+    GtkWidget *sezione_lavoro;
+    GtkWidget *sezione_plex;
+    GtkRoot *radice;
+
+    st->finestra = finestra;
+    st->titolo = titolo;
+    carica_ini (st);
+    carica_segnalibri (st);
+
+    gtk_window_set_title (GTK_WINDOW (finestra), _("Configure sidebar groups"));
+    gtk_window_set_default_size (GTK_WINDOW (finestra), 640, 560);
+    gtk_window_set_modal (GTK_WINDOW (finestra), TRUE);
+    radice = gtk_widget_get_root (genitore);
+    if (radice != NULL && GTK_IS_WINDOW (radice))
+    {
+        gtk_window_set_transient_for (GTK_WINDOW (finestra), GTK_WINDOW (radice));
+    }
+    adw_header_bar_set_title_widget (ADW_HEADER_BAR (testa), titolo);
+    adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (vista), testa);
+
+    gtk_scrolled_window_set_policy (GTK_SCROLLED_WINDOW (scorsoio),
+                                    GTK_POLICY_NEVER, GTK_POLICY_AUTOMATIC);
+    gtk_widget_set_vexpand (scorsoio, TRUE);
+    adw_clamp_set_maximum_size (ADW_CLAMP (morsetto), 520);
+    gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (scorsoio), morsetto);
+    g_object_set (colonna, "margin-top", 16, "margin-bottom", 16,
+                  "margin-start", 6, "margin-end", 6, NULL);
+    adw_clamp_set_child (ADW_CLAMP (morsetto), colonna);
+
+    /* Dischi: solo informativo, segue i volumi del sistema */
+    gruppo_dischi = gtk_box_new (GTK_ORIENTATION_VERTICAL, 6);
+    {
+        GtkWidget *etichetta = gtk_label_new (_("Disks"));
+        GtkWidget *lista = gtk_list_box_new ();
+        GtkWidget *riga = adw_action_row_new ();
+        GtkWidget *icona = gtk_image_new_from_icon_name ("drive-harddisk-symbolic");
+
+        gtk_widget_add_css_class (etichetta, "heading");
+        gtk_widget_set_halign (etichetta, GTK_ALIGN_START);
+        adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga),
+                                       _("Follows the system volumes"));
+        adw_action_row_add_prefix (ADW_ACTION_ROW (riga), icona);
+        gtk_widget_add_css_class (lista, "boxed-list");
+        gtk_list_box_set_selection_mode (GTK_LIST_BOX (lista), GTK_SELECTION_NONE);
+        gtk_list_box_append (GTK_LIST_BOX (lista), riga);
+        gtk_box_append (GTK_BOX (gruppo_dischi), etichetta);
+        gtk_box_append (GTK_BOX (gruppo_dischi), lista);
+    }
+
+    sezione_lavoro = gruppo_finestra (st, _("Work"), FALSE);
+    sezione_plex = gruppo_finestra (st, "Plex", TRUE);
+
+    gtk_box_append (GTK_BOX (colonna), gruppo_dischi);
+    gtk_box_append (GTK_BOX (colonna), sezione_lavoro);
+    gtk_box_append (GTK_BOX (colonna), sezione_plex);
+
+    adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (vista), scorsoio);
+
+    /* barra d'azione in basso: agisce sulla voce SELEZIONATA (solo
+     * «Rinomina…»: «Cambia icona» e «Sposta» sono di INC-4b, spenti) */
+    st->btn_rinomina = gtk_button_new_with_label (_("Rename…"));
+    g_signal_connect (st->btn_rinomina, "clicked", G_CALLBACK (su_rinomina), st);
+    gtk_action_bar_pack_start (GTK_ACTION_BAR (azione), st->btn_rinomina);
+#ifdef CODLAB_INC4B
+    st->btn_icona = gtk_button_new_with_label (_("Change icon"));
+    st->btn_su = gtk_button_new_with_label (_("Move up"));
+    st->btn_giu = gtk_button_new_with_label (_("Move down"));
+    g_signal_connect (st->btn_icona, "clicked", G_CALLBACK (su_icona), st);
+    g_signal_connect (st->btn_su, "clicked", G_CALLBACK (su_su), st);
+    g_signal_connect (st->btn_giu, "clicked", G_CALLBACK (su_giu), st);
+    gtk_action_bar_pack_start (GTK_ACTION_BAR (azione), st->btn_icona);
+    gtk_action_bar_pack_end (GTK_ACTION_BAR (azione), st->btn_giu);
+    gtk_action_bar_pack_end (GTK_ACTION_BAR (azione), st->btn_su);
+#endif
+    /* le liste si deselezionano anche mentre la finestra si smonta (e
+     * aggiorna_bottoni tocca questi bottoni): restano vivi quanto lo stato */
+    g_object_ref (st->btn_rinomina);
+#ifdef CODLAB_INC4B
+    g_object_ref (st->btn_icona);
+    g_object_ref (st->btn_su);
+    g_object_ref (st->btn_giu);
+#endif
+    adw_toolbar_view_add_bottom_bar (ADW_TOOLBAR_VIEW (vista), azione);
+
+    adw_window_set_content (ADW_WINDOW (finestra), vista);
+
+    ricostruisci_lavoro (st);
+    ricostruisci_plex (st);
+    aggiorna_bottoni (st);
+    aggiorna_sottotitolo (st);
+
+    {
+        GtkEventController *tasti = gtk_event_controller_key_new ();
+
+        g_signal_connect (tasti, "key-pressed", G_CALLBACK (su_tasto_config),
+                          finestra);
+        gtk_widget_add_controller (GTK_WIDGET (finestra), tasti);
+    }
+
+    /* lo stato vive quanto la finestra: le callback non restano appese */
+    g_object_set_data_full (G_OBJECT (finestra), "stato-codlab", st, stato_free);
+    return finestra;
+}
