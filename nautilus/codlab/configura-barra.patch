diff --git a/src/nautilus-sidebar-config.c b/src/nautilus-sidebar-config.c
new file mode 100644
index 0000000..b96b597
--- /dev/null
+++ b/src/nautilus-sidebar-config.c
@@ -0,0 +1,1697 @@
+/* nautilus-sidebar-config.c — CodLab (INC-4): finestra «Configura» per i
+ * gruppi della barra laterale.
+ *
+ * Oggi i gruppi Dischi/Lavoro/Plex si configurano solo a mano: barra.ini
+ * (Plex) e segnalibri GTK (Lavoro). Questa finestra li edita dalla UI:
+ * crea una voce, la rinomina e aggiunge una cartella (il selettore di
+ * Nautilus stesso, NAUTILUS_MODE_OPEN_FOLDER). Il gruppo Dischi segue i
+ * volumi del sistema: compare solo come riga informativa.
+ *
+ * «Sposta su», «Sposta giù» e «Cambia icona» (voci Plex: è l'unico
+ * formato che supporta l'icona) NON sono nella finestra dal 03.11.2026
+ * (richiesta: «nascondi icona e sposta»), perché non hanno prove. Il
+ * loro codice resta in questo file per INC-4b, spento dal preprocessore
+ * nei blocchi «#ifdef CODLAB_INC4B»: senza quella definizione non entra
+ * nel binario, quindi nessun bottone, nessun tasto e nessun menu li
+ * raggiunge. Si riaccendono definendo CODLAB_INC4B, con le loro prove.
+ *
+ * Regole ferree (lezioni INC-1/2/3, le cercano i revisori):
+ *  - barra.ini resta nel formato della patch blocchi-barra: una sezione
+ *    per voce, Name e Uri obbligatori, Icon facoltativa, ordine delle
+ *    sezioni = ordine nel gruppo (GKeyFile preserva l'ordine sia in
+ *    lettura sia in scrittura: verificato prima di scriverlo). La
+ *    finestra ne MOSTRA le prime SEZIONI_BARRA, come la barra, ma le
+ *    carica TUTTE, e il file lo scrive SUL POSTO: parte dai byte letti
+ *    (commenti, righe vuote, traduzioni, sezioni che la barra scarta,
+ *    chiavi extra) e cambia solo cio' che la finestra ha cambiato, cioe'
+ *    il Name di una voce o una sezione nuova in fondo. S1 della revisione
+ *    del 04.11: il 2.3 caricava le prime 64 sezioni e riscriveva il
+ *    file con quelle sole;
+ *  - i segnalibri GTK restano nel formato «uri etichetta» una riga per
+ *    voce; le righe non interpretabili si riportano identiche;
+ *  - una scrittura che perderebbe dati RIFIUTA, avvisa e non tocca ne'
+ *    il file ne' il .bak: se il file sul disco non e' piu' quello letto
+ *    dalla finestra (l'ha cambiato un altro programma: si chiude e si
+ *    riapre la finestra), se non si legge, o se il contenuto nuovo non
+ *    ha tutte le sezioni e le chiavi (barra.ini) o tutte le righe
+ *    (segnalibri) di quello di prima. Chi chiama rimette il modello
+ *    com'era: finestra e file restano uguali;
+ *  - ogni scrittura è atomica (g_file_set_contents: temporaneo + rename)
+ *    e prima di scrivere lascia la copia di prima in <file>.bak;
+ *  - la chiave org.gnome.nautilus.codlab:gruppi-personalizzati si scrive
+ *    solo dopo una modifica riuscita, con la guardia has_key per-chiave:
+ *    con uno schema vecchio la finestra funziona lo stesso, niente abort;
+ *  - niente template: tutta l'interfaccia è costruita qui in C, quindi
+ *    niente callback di template da bindare (zero Gtk-CRITICAL);
+ *  - la barra laterale si aggiorna da sola: i monitor di barra.ini e dei
+ *    segnalibri già esistono (patch blocchi-barra / NautilusBookmarkList)
+ *    — MA il watch inotify di barra.ini è condiviso con la sidebar
+ *    interna del selettore e muore con lei (misurato 02.11): per questo
+ *    ogni salva_ini risveglia subito la barra e alla chiusura del
+ *    selettore si arma un monitor di riserva (vedi risveglia_barra).
+ */
+
+#include <glib/gi18n.h>
+#include <adwaita.h>
+
+#include "nautilus-application.h"
+#include "nautilus-bookmark-list.h"
+#include "nautilus-file-chooser.h"
+#include "nautilus-global-preferences.h"
+#include "nautilus-sidebar-config.h"
+
+/* il sottotitolo della finestra dice solo cio' che la finestra fa */
+#ifdef CODLAB_INC4B
+#define SOTTOTITOLO_CONFIGURA N_("Create, rename and move the entries")
+#else
+#define SOTTOTITOLO_CONFIGURA N_("Create and rename the entries")
+#endif
+
+/* le sezioni di barra.ini che la barra mostra (patch blocchi-barra): la
+ * finestra mostra le stesse e non ne crea oltre; il file le tiene tutte */
+#define SEZIONI_BARRA 64
+/* barra.ini si legge e si riscrive con commenti, righe vuote e traduzioni */
+#define FLAG_INI (G_KEY_FILE_KEEP_COMMENTS | G_KEY_FILE_KEEP_TRANSLATIONS)
+
+/* ------------------------------------------------- risveglio della barra
+ *
+ * Il monitor di barra.ini della barra laterale e il monitor della
+ * sidebar INTERNA del selettore condividono lo stesso watch inotify del
+ * kernel: quando il selettore si chiude, il suo g_clear_object cancella
+ * il watch e il monitor della barra resta SORDO (misurato 02.11: la
+ * voce veniva scritta e la barra vera non si aggiornava, ne' allora ne'
+ * per le scritture successive; il monitor dei segnalibri non c'entra,
+ * vive sulla lista dell'applicazione). Due rimedi, entrambi qui:
+ *  - dopo OGNI salva_ini si emette «changed» sulla lista segnalibri
+ *    dell'applicazione, che la barra gia' ascolta con update_places
+ *    (ricostruzione completa, rilegge anche barra.ini);
+ *  - alla distruzione del selettore si arma un monitor DI RISERVA su
+ *    barra.ini (nuovo watch, mai cancellato: vive quanto il processo)
+ *    che fa lo stesso per le scritture future. */
+
+static GFileMonitor *monitor_barra_riserva = NULL;
+
+static char *percorso_barra_ini (void);
+
+static void
+risveglia_barra (void)
+{
+    NautilusApplication *app = NAUTILUS_APPLICATION (g_application_get_default ());
+
+    if (app != NULL)
+    {
+        g_signal_emit_by_name (nautilus_application_get_bookmarks (app),
+                               "changed");
+    }
+}
+
+static void
+barra_ini_cambiata_riserva (GFileMonitor      *monitor,
+                            GFile             *file,
+                            GFile             *altro_file,
+                            GFileMonitorEvent  evento,
+                            gpointer           dato)
+{
+    if (evento == G_FILE_MONITOR_EVENT_CHANGES_DONE_HINT ||
+        evento == G_FILE_MONITOR_EVENT_CREATED ||
+        evento == G_FILE_MONITOR_EVENT_DELETED ||
+        evento == G_FILE_MONITOR_EVENT_RENAMED ||
+        evento == G_FILE_MONITOR_EVENT_MOVED_IN ||
+        evento == G_FILE_MONITOR_EVENT_MOVED_OUT)
+    {
+        risveglia_barra ();
+    }
+}
+
+static void
+arma_monitor_barra (GtkWidget *oggetto,
+                    gpointer   dato)
+{
+    (void) oggetto;
+    (void) dato;
+
+    if (monitor_barra_riserva != NULL)
+    {
+        return;
+    }
+    g_autofree char *percorso = percorso_barra_ini ();
+    g_autoptr (GFile) file = g_file_new_for_path (percorso);
+
+    monitor_barra_riserva = g_file_monitor_file (file, G_FILE_MONITOR_NONE,
+                                                 NULL, NULL);
+    if (monitor_barra_riserva != NULL)
+    {
+        g_signal_connect (monitor_barra_riserva, "changed",
+                          G_CALLBACK (barra_ini_cambiata_riserva), NULL);
+    }
+}
+
+/* ---------------------------------------------------------------- modello */
+
+typedef struct
+{
+    char *sezione;      /* nome della sezione INI, es. «Folder 02» */
+    gboolean valida;    /* Name + Uri file:/// presenti (il lettore la mostra) */
+    char *nome;         /* Name */
+    char *uri;          /* Uri */
+    char *icona;        /* Icon, "" se assente */
+} SezioneIni;
+
+typedef struct
+{
+    char *uri;
+    char *etichetta;    /* può essere "" */
+    char *grezza;       /* riga non interpretabile: si riporta identica */
+} RigaSegnalibro;
+
+typedef struct
+{
+    GtkWidget *finestra;
+    GtkWidget *titolo;          /* AdwWindowTitle */
+    GtkWidget *lista_lavoro;    /* GtkListBox */
+    GtkWidget *lista_plex;      /* GtkListBox */
+    GtkWidget *btn_rinomina;
+#ifdef CODLAB_INC4B
+    GtkWidget *btn_icona;
+    GtkWidget *btn_su;
+    GtkWidget *btn_giu;
+#endif
+    GPtrArray *ini;             /* SezioneIni, in ordine di file */
+    GPtrArray *segnalibri;      /* RigaSegnalibro, in ordine di file */
+    GKeyFile *kf_lettura;       /* barra.ini com'e' sul disco (FLAG_INI) */
+    GBytes *ini_letto;          /* byte di barra.ini letti o scritti per ultimi; NULL: assente */
+    gboolean ini_illeggibile;   /* barra.ini c'e' ma non si legge: non si riscrive */
+    GBytes *seg_letto;          /* lo stesso per i segnalibri */
+    gboolean seg_illeggibili;
+    GtkListBoxRow *sel_lavoro;  /* selezione corrente (una sola lista) */
+    GtkListBoxRow *sel_plex;
+} StatoConfig;
+
+/* parametri dei dialoghi, vivi quanto il dialogo che li porta */
+typedef struct
+{
+    StatoConfig *st;
+    gboolean plex;
+    int indice;             /* -1 per la voce NUOVA */
+    GtkWidget *voce_nome;
+    GtkWidget *voce_cartella;
+    GtkWidget *voce_icona;
+    GtkWidget *anteprima;
+} DatiDialogo;
+
+static void ricostruisci_lavoro (StatoConfig *st);
+static void ricostruisci_plex (StatoConfig *st);
+static void aggiorna_bottoni (StatoConfig *st);
+static gboolean salva_ini (StatoConfig *st);
+static gboolean salva_segnalibri (StatoConfig *st);
+static void su_conferma_dialogo (GtkButton *pulsante, gpointer dato);
+
+/* ------------------------------------------------------------ percorsi */
+
+static char *
+percorso_barra_ini (void)
+{
+    return g_build_filename (g_get_user_config_dir (), "nautilus-codlab",
+                             "barra.ini", NULL);
+}
+
+static char *
+percorso_segnalibri (void)
+{
+    /* Stesso percorso di nautilus_bookmark_list_get_file(): con
+     * XDG_CONFIG_HOME (isola delle prove) g_get_user_config_dir() lo
+     * segue, quindi i segnalibri VERI dell'utente non si toccano mai. */
+    return g_build_filename (g_get_user_config_dir (), "gtk-3.0",
+                             "bookmarks", NULL);
+}
+
+/* ------------------------------------------------- scrittura atomica+bak */
+
+/* Scrive contenuto su percorso in modo atomico (temporaneo + rename,
+ * è g_file_set_contents) lasciando PRIMA la copia del contenuto attuale
+ * in <percorso>.bak. Torna FALSE con errore impostato se la copia o la
+ * scrittura falliscono: in quel caso il file originale è intatto. */
+static gboolean
+scrivi_con_copia (const char *percorso, const char *contenuto, GError **errore)
+{
+    if (g_file_test (percorso, G_FILE_TEST_EXISTS))
+    {
+        g_autofree char *vecchio = NULL;
+        g_autofree char *bak = g_strconcat (percorso, ".bak", NULL);
+
+        if (!g_file_get_contents (percorso, &vecchio, NULL, errore))
+        {
+            return FALSE;
+        }
+        if (!g_file_set_contents (bak, vecchio, -1, errore))
+        {
+            return FALSE;
+        }
+    }
+    return g_file_set_contents (percorso, contenuto, -1, errore);
+}
+
+/* I byte di un file, o NULL con l'errore (G_FILE_ERROR_NOENT: non c'e'). */
+static GBytes *
+leggi_byte (const char *percorso, GError **errore)
+{
+    char *contenuto = NULL;
+    gsize lunghezza = 0;
+
+    if (!g_file_get_contents (percorso, &contenuto, &lunghezza, errore))
+    {
+        return NULL;
+    }
+    return g_bytes_new_take (contenuto, lunghezza);
+}
+
+/* Il testo (terminato) di byte letti; "" per NULL o per un file vuoto. */
+static char *
+testo_di (GBytes *byte)
+{
+    gsize lunghezza = 0;
+    const char *dati = byte != NULL ? g_bytes_get_data (byte, &lunghezza) : NULL;
+
+    return g_strndup (dati != NULL ? dati : "", lunghezza);
+}
+
+/* Il file sul disco e' ancora quello che la finestra ha letto, o scritto
+ * per ultima? Anche: assente allora e assente adesso. */
+static gboolean
+disco_come_letto (const char *percorso, GBytes *letto)
+{
+    g_autoptr (GError) errore = NULL;
+    g_autoptr (GBytes) ora = leggi_byte (percorso, &errore);
+
+    if (ora == NULL)
+    {
+        return letto == NULL && g_error_matches (errore, G_FILE_ERROR, G_FILE_ERROR_NOENT);
+    }
+    return letto != NULL && g_bytes_equal (ora, letto);
+}
+
+/* Una scrittura rifiutata: niente e' stato scritto, ne' il file ne' il .bak. */
+static void
+avvisa_non_salvato (StatoConfig *st, const char *corpo)
+{
+    AdwDialog *avviso = adw_alert_dialog_new (_("Not saved"), corpo);
+
+    adw_alert_dialog_add_response (ADW_ALERT_DIALOG (avviso), "ok", _("Cancel"));
+    adw_dialog_present (avviso, st->finestra);
+}
+
+/* La guardia comune, PRIMA di comporre il contenuto nuovo: il file deve
+ * leggersi ed essere ancora quello letto dalla finestra. Se un altro
+ * programma l'ha cambiato (genera-plex, un segnalibro aggiunto da un'altra
+ * finestra, una modifica a mano) si rifiuta: riscriverlo dal modello lo
+ * cancellerebbe, e alla scrittura dopo anche dal .bak. */
+static gboolean
+si_puo_scrivere (StatoConfig *st, const char *percorso, GBytes *letto,
+                 gboolean illeggibile)
+{
+    if (illeggibile)
+    {
+        avvisa_non_salvato (st, _("The file cannot be read: nothing was saved."));
+        return FALSE;
+    }
+    if (!disco_come_letto (percorso, letto))
+    {
+        avvisa_non_salvato (st, _("The file was changed outside this window: nothing was saved. Close the window and open it again."));
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* ------------------------------------------------------------- barra.ini */
+
+static void
+sezione_ini_free (gpointer dato)
+{
+    SezioneIni *s = dato;
+
+    g_free (s->sezione);
+    g_free (s->nome);
+    g_free (s->uri);
+    g_free (s->icona);
+    g_free (s);
+}
+
+/* Carica TUTTE le sezioni di barra.ini, NELLO STESSO ORDINE che leggerà la
+ * barra (g_key_file_get_groups della patch blocchi-barra; GKeyFile preserva
+ * l'ordine del file: verificato). La finestra mostra le prime
+ * SEZIONI_BARRA, come la barra; le altre restano nel modello e nel file.
+ * Le sezioni invalide restano nel modello (valida=FALSE) e nel file. */
+static void
+carica_ini (StatoConfig *st)
+{
+    g_autofree char *percorso = percorso_barra_ini ();
+    g_autoptr (GError) errore = NULL;
+    g_auto (GStrv) gruppi = NULL;
+
+    st->ini = g_ptr_array_new_with_free_func (sezione_ini_free);
+    st->kf_lettura = g_key_file_new ();
+
+    st->ini_letto = leggi_byte (percorso, &errore);
+    if (st->ini_letto == NULL)
+    {
+        /* assente: la prima voce lo crea; c'e' ma non si legge: mai riscritto */
+        st->ini_illeggibile = !g_error_matches (errore, G_FILE_ERROR, G_FILE_ERROR_NOENT);
+        return;
+    }
+    if (!g_key_file_load_from_bytes (st->kf_lettura, st->ini_letto, FLAG_INI, NULL))
+    {
+        /* non e' un keyfile (la barra non ne mostra niente): mai riscritto */
+        st->ini_illeggibile = TRUE;
+        return;
+    }
+
+    gruppi = g_key_file_get_groups (st->kf_lettura, NULL);
+    for (guint i = 0; gruppi != NULL && gruppi[i] != NULL; i++)
+    {
+        SezioneIni *s = g_new0 (SezioneIni, 1);
+
+        s->sezione = g_strdup (gruppi[i]);
+        s->nome = g_key_file_get_string (st->kf_lettura, gruppi[i], "Name", NULL);
+        s->uri = g_key_file_get_string (st->kf_lettura, gruppi[i], "Uri", NULL);
+        s->icona = g_key_file_get_string (st->kf_lettura, gruppi[i], "Icon", NULL);
+        /* stessa validità del lettore della barra: Name non vuoto (senza
+         * a-capo) e Uri file:/// */
+        s->valida = (s->nome != NULL && *s->nome != '\0' &&
+                     strpbrk (s->nome, "\r\n") == NULL &&
+                     s->uri != NULL && g_str_has_prefix (s->uri, "file:///"));
+        g_ptr_array_add (st->ini, s);
+    }
+}
+
+/* Mette chiave=valore solo se nel keyfile il valore e' diverso (o manca):
+ * cio' che la finestra non ha cambiato resta scritto com'era, escape
+ * compresi. */
+static void
+imposta_se_diversa (GKeyFile *kf, const char *sezione, const char *chiave,
+                    const char *valore)
+{
+    g_autofree char *attuale = g_key_file_get_string (kf, sezione, chiave, NULL);
+
+    if (valore != NULL && g_strcmp0 (attuale, valore) != 0)
+    {
+        g_key_file_set_string (kf, sezione, chiave, valore);
+    }
+}
+
+/* Il contenuto nuovo ha TUTTE le sezioni e TUTTE le chiavi (traduzioni
+ * comprese) del file letto? Se ne manca anche una sola, non si scrive. */
+static gboolean
+nessuna_perdita (GKeyFile *prima, const char *contenuto, gsize lunghezza)
+{
+    g_autoptr (GKeyFile) dopo = g_key_file_new ();
+    g_auto (GStrv) gruppi = g_key_file_get_groups (prima, NULL);
+
+    if (!g_key_file_load_from_data (dopo, contenuto, lunghezza,
+                                    G_KEY_FILE_KEEP_TRANSLATIONS, NULL))
+    {
+        return FALSE;
+    }
+    for (guint i = 0; gruppi != NULL && gruppi[i] != NULL; i++)
+    {
+        g_auto (GStrv) chiavi = g_key_file_get_keys (prima, gruppi[i], NULL, NULL);
+
+        if (!g_key_file_has_group (dopo, gruppi[i]))
+        {
+            return FALSE;
+        }
+        for (guint k = 0; chiavi != NULL && chiavi[k] != NULL; k++)
+        {
+            if (!g_key_file_has_key (dopo, gruppi[i], chiavi[k], NULL))
+            {
+                return FALSE;
+            }
+        }
+    }
+    return TRUE;
+}
+
+/* Scrive barra.ini SUL POSTO (vedi la testata del file): dai byte letti,
+ * cambiando solo Name/Uri/Icon dove il modello e' diverso e aggiungendo in
+ * fondo le sezioni nuove; le sezioni che la barra scarta, le chiavi extra,
+ * i commenti e le traduzioni restano come sono. Rende FALSE senza aver
+ * scritto niente (ne' il file ne' il .bak) se la guardia rifiuta, se il
+ * contenuto nuovo perderebbe una sezione o una chiave o se la scrittura
+ * fallisce: chi chiama rimette il modello com'era. */
+static gboolean
+salva_ini (StatoConfig *st)
+{
+    g_autoptr (GKeyFile) nuovo = g_key_file_new ();
+    g_autofree char *percorso = percorso_barra_ini ();
+    g_autofree char *contenuto = NULL;
+    gsize lunghezza = 0;
+    g_autoptr (GError) errore = NULL;
+
+    if (!si_puo_scrivere (st, percorso, st->ini_letto, st->ini_illeggibile))
+    {
+        return FALSE;
+    }
+    if (st->ini_letto != NULL &&
+        !g_key_file_load_from_bytes (nuovo, st->ini_letto, FLAG_INI, NULL))
+    {
+        avvisa_non_salvato (st, _("The file cannot be read: nothing was saved."));
+        return FALSE;
+    }
+    for (guint i = 0; i < st->ini->len; i++)
+    {
+        SezioneIni *s = g_ptr_array_index (st->ini, i);
+
+        if (!s->valida)
+        {
+            continue;       /* la barra la scarta: resta com'e' */
+        }
+        imposta_se_diversa (nuovo, s->sezione, "Name", s->nome);
+        imposta_se_diversa (nuovo, s->sezione, "Uri", s->uri);
+        if (s->icona != NULL && *s->icona != '\0')
+        {
+            imposta_se_diversa (nuovo, s->sezione, "Icon", s->icona);
+        }
+    }
+
+    contenuto = g_key_file_to_data (nuovo, &lunghezza, NULL);
+    if (contenuto == NULL)
+    {
+        return FALSE;
+    }
+    if (!nessuna_perdita (st->kf_lettura, contenuto, lunghezza))
+    {
+        avvisa_non_salvato (st, _("The new content would lose entries of the file: nothing was saved."));
+        return FALSE;
+    }
+    if (!scrivi_con_copia (percorso, contenuto, &errore))
+    {
+        g_warning ("Configura: impossibile scrivere %s: %s", percorso,
+                   errore != NULL ? errore->message : "?");
+        avvisa_non_salvato (st, _("The file cannot be written: nothing was saved."));
+        return FALSE;
+    }
+    /* il file appena scritto e' la base delle PROSSIME modifiche */
+    g_bytes_unref (st->ini_letto);
+    st->ini_letto = g_bytes_new_take (g_steal_pointer (&contenuto), lunghezza);
+    g_key_file_load_from_bytes (st->kf_lettura, st->ini_letto, FLAG_INI, NULL);
+    nautilus_codlab_preferences_set_gruppi_personalizzati (TRUE);
+    /* il monitor della barra puo' essere sordo (vedi arma_monitor_barra):
+     * si risveglia subito, qui, senza aspettare gli eventi */
+    risveglia_barra ();
+    return TRUE;
+}
+
+/* Nuovo nome di sezione univoco, nello stile di genera-plex.py. */
+static char *
+nuova_sezione_ini (StatoConfig *st)
+{
+    for (guint n = 1; n <= 999; n++)
+    {
+        g_autofree char *candidato = g_strdup_printf ("Folder %02u", n);
+        gboolean usato = FALSE;
+
+        for (guint i = 0; i < st->ini->len; i++)
+        {
+            SezioneIni *s = g_ptr_array_index (st->ini, i);
+            if (g_strcmp0 (s->sezione, candidato) == 0)
+            {
+                usato = TRUE;
+                break;
+            }
+        }
+        if (!usato)
+        {
+            return g_steal_pointer (&candidato);
+        }
+    }
+    return g_strdup ("Folder nuova");
+}
+
+/* ------------------------------------------------------------ segnalibri */
+
+static void
+riga_segnalibro_free (gpointer dato)
+{
+    RigaSegnalibro *r = dato;
+
+    g_free (r->uri);
+    g_free (r->etichetta);
+    g_free (r->grezza);
+    g_free (r);
+}
+
+static void
+carica_segnalibri (StatoConfig *st)
+{
+    g_autofree char *percorso = percorso_segnalibri ();
+    g_autofree char *contenuto = NULL;
+    g_autoptr (GError) errore = NULL;
+    g_auto (GStrv) righe = NULL;
+
+    st->segnalibri = g_ptr_array_new_with_free_func (riga_segnalibro_free);
+
+    st->seg_letto = leggi_byte (percorso, &errore);
+    if (st->seg_letto == NULL)
+    {
+        /* assenti: la prima voce li crea; ci sono ma non si leggono: mai riscritti */
+        st->seg_illeggibili = !g_error_matches (errore, G_FILE_ERROR, G_FILE_ERROR_NOENT);
+        return;
+    }
+    contenuto = testo_di (st->seg_letto);
+    righe = g_strsplit (contenuto, "\n", -1);
+    for (guint i = 0; righe != NULL && righe[i] != NULL; i++)
+    {
+        if (*righe[i] == '\0')
+        {
+            continue;
+        }
+        RigaSegnalibro *r = g_new0 (RigaSegnalibro, 1);
+        char *spazio = strchr (righe[i], ' ');
+
+        if (spazio == NULL)
+        {
+            r->uri = g_strdup (righe[i]);
+            r->etichetta = g_strdup ("");
+        }
+        else
+        {
+            r->uri = g_strndup (righe[i], spazio - righe[i]);
+            r->etichetta = g_strdup (spazio + 1);
+        }
+        /* riga non interpretabile come URI con schema: si riporta identica */
+        if (r->uri == NULL || strstr (r->uri, "://") == NULL)
+        {
+            g_free (r->uri);
+            g_free (r->etichetta);
+            r->uri = NULL;
+            r->etichetta = NULL;
+            r->grezza = g_strdup (righe[i]);
+        }
+        g_ptr_array_add (st->segnalibri, r);
+    }
+}
+
+/* Il testo nuovo dei segnalibri ha tutte le righe di prima? Si contano per
+ * URI (la riga intera se non e' «uri etichetta»), doppioni compresi: la
+ * rinomina cambia l'etichetta, mai l'URI. */
+static gboolean
+nessuna_riga_persa (GBytes *prima, const char *dopo)
+{
+    g_autoptr (GHashTable) conta = g_hash_table_new_full (g_str_hash, g_str_equal,
+                                                          g_free, NULL);
+    g_autofree char *vecchio = testo_di (prima);
+    const char *testi[2] = { vecchio, dopo };
+    GHashTableIter it;
+    gpointer n;
+
+    for (guint t = 0; t < 2; t++)
+    {
+        g_auto (GStrv) righe = g_strsplit (testi[t], "\n", -1);
+
+        for (guint i = 0; righe[i] != NULL; i++)
+        {
+            const char *spazio = strchr (righe[i], ' ');
+            char *chiave;
+
+            if (*righe[i] == '\0')
+            {
+                continue;
+            }
+            chiave = spazio != NULL ? g_strndup (righe[i], spazio - righe[i]) :
+                                      g_strdup (righe[i]);
+            n = g_hash_table_lookup (conta, chiave);
+            g_hash_table_replace (conta, chiave,
+                                  GINT_TO_POINTER (GPOINTER_TO_INT (n) + (t == 0 ? 1 : -1)));
+        }
+    }
+    g_hash_table_iter_init (&it, conta);
+    while (g_hash_table_iter_next (&it, NULL, &n))
+    {
+        if (GPOINTER_TO_INT (n) > 0)
+        {
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+/* Scrive i segnalibri dal modello, con le stesse guardie di salva_ini e
+ * lo stesso contratto: FALSE senza aver scritto niente. */
+static gboolean
+salva_segnalibri (StatoConfig *st)
+{
+    g_autofree char *percorso = percorso_segnalibri ();
+    g_autoptr (GString) testo = g_string_new (NULL);
+    g_autoptr (GError) errore = NULL;
+
+    if (!si_puo_scrivere (st, percorso, st->seg_letto, st->seg_illeggibili))
+    {
+        return FALSE;
+    }
+    for (guint i = 0; i < st->segnalibri->len; i++)
+    {
+        RigaSegnalibro *r = g_ptr_array_index (st->segnalibri, i);
+
+        if (r->grezza != NULL)
+        {
+            g_string_append_printf (testo, "%s\n", r->grezza);
+        }
+        else if (*r->etichetta == '\0')
+        {
+            g_string_append_printf (testo, "%s\n", r->uri);
+        }
+        else
+        {
+            g_string_append_printf (testo, "%s %s\n", r->uri, r->etichetta);
+        }
+    }
+    if (!nessuna_riga_persa (st->seg_letto, testo->str))
+    {
+        avvisa_non_salvato (st, _("The new content would lose entries of the file: nothing was saved."));
+        return FALSE;
+    }
+    if (!scrivi_con_copia (percorso, testo->str, &errore))
+    {
+        g_warning ("Configura: impossibile scrivere %s: %s", percorso,
+                   errore != NULL ? errore->message : "?");
+        avvisa_non_salvato (st, _("The file cannot be written: nothing was saved."));
+        return FALSE;
+    }
+    g_bytes_unref (st->seg_letto);
+    st->seg_letto = g_bytes_new (testo->str, testo->len);
+    nautilus_codlab_preferences_set_gruppi_personalizzati (TRUE);
+    return TRUE;
+}
+
+/* -------------------------------------------------------------- utilità */
+
+/* L'etichetta da mostrare per un URI: il nome finale del percorso, come
+ * fa la barra con i segnalibri locali. */
+static char *
+etichetta_uri (const char *uri)
+{
+    if (uri == NULL)
+    {
+        return g_strdup ("");
+    }
+    g_autoptr (GFile) file = g_file_new_for_uri (uri);
+
+    if (g_file_is_native (file))
+    {
+        char *base = g_file_get_basename (file);
+
+        return base != NULL ? base : g_strdup (uri);
+    }
+    return g_uri_unescape_string (uri, NULL);
+}
+
+/* Esiste già una voce con questo URI nel gruppo? (rifiuta i doppioni:
+ * plex=FALSE cerca nei segnalibri, plex=TRUE nelle sezioni di barra.ini) */
+static gboolean
+uri_gia_presente (StatoConfig *st, gboolean plex, const char *uri)
+{
+    GPtrArray *voci = plex ? st->ini : st->segnalibri;
+
+    for (guint i = 0; i < voci->len; i++)
+    {
+        const char *altro = plex ?
+                            ((SezioneIni *) g_ptr_array_index (voci, i))->uri :
+                            ((RigaSegnalibro *) g_ptr_array_index (voci, i))->uri;
+
+        if (g_strcmp0 (altro, uri) == 0)
+        {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* Aggiunge una voce Plex o Lavoro da un GFile già validato come cartella,
+ * con la sua etichetta. Ritorna TRUE se aggiunta (e salvata). */
+static gboolean
+aggiungi_voce (StatoConfig *st, gboolean plex, GFile *cartella,
+               const char *nome, const char *icona)
+{
+    g_autofree char *uri = g_file_get_uri (cartella);
+    GPtrArray *voci = plex ? st->ini : st->segnalibri;
+
+    if (uri_gia_presente (st, plex, uri))
+    {
+        return FALSE;
+    }
+    if (plex && voci->len >= SEZIONI_BARRA)
+    {
+        return FALSE;
+    }
+    if (plex)
+    {
+        SezioneIni *s = g_new0 (SezioneIni, 1);
+
+        s->sezione = nuova_sezione_ini (st);
+        s->valida = TRUE;
+        s->nome = g_strdup (nome != NULL && *nome != '\0' ? nome : uri);
+        s->uri = g_strdup (uri);
+        s->icona = g_strdup (icona != NULL ? icona : "");
+        g_ptr_array_add (voci, s);
+        if (!salva_ini (st))
+        {
+            /* niente scritto: la voce esce anche dal modello */
+            g_ptr_array_remove_index (voci, voci->len - 1);
+            return FALSE;
+        }
+        ricostruisci_plex (st);
+    }
+    else
+    {
+        RigaSegnalibro *r = g_new0 (RigaSegnalibro, 1);
+
+        r->uri = g_strdup (uri);
+        r->etichetta = g_strdup (nome != NULL && *nome != '\0' ? nome : "");
+        g_ptr_array_add (voci, r);
+        if (!salva_segnalibri (st))
+        {
+            g_ptr_array_remove_index (voci, voci->len - 1);
+            return FALSE;
+        }
+        ricostruisci_lavoro (st);
+    }
+    GtkListBox *lista = plex ? GTK_LIST_BOX (st->lista_plex) :
+                       GTK_LIST_BOX (st->lista_lavoro);
+
+    gtk_list_box_select_row (lista, gtk_list_box_get_row_at_index (
+                                 lista, (plex ? st->ini : st->segnalibri)->len - 1));
+    aggiorna_bottoni (st);
+    return TRUE;
+}
+
+static void
+avvisa (StatoConfig *st, const char *corpo)
+{
+    AdwDialog *avviso = adw_alert_dialog_new (_("Cannot add"), corpo);
+
+    adw_alert_dialog_add_response (ADW_ALERT_DIALOG (avviso), "ok", _("Cancel"));
+    adw_dialog_present (avviso, st->finestra);
+}
+
+/* ------------------------------------------------------------ interfaccia */
+
+static void
+aggiorna_sottotitolo (StatoConfig *st)
+{
+    if (nautilus_codlab_preferences_get_gruppi_personalizzati ())
+    {
+        adw_window_title_set_subtitle (ADW_WINDOW_TITLE (st->titolo),
+                                       _("Personalized"));
+    }
+}
+
+static void
+aggiorna_bottoni (StatoConfig *st)
+{
+    GtkListBoxRow *riga = st->sel_plex != NULL ? st->sel_plex : st->sel_lavoro;
+
+    gtk_widget_set_sensitive (st->btn_rinomina, riga != NULL);
+#ifdef CODLAB_INC4B
+    gboolean plex = st->sel_plex != NULL;
+
+    gtk_widget_set_sensitive (st->btn_icona, plex);
+    gtk_widget_set_sensitive (st->btn_su, riga != NULL);
+    gtk_widget_set_sensitive (st->btn_giu, riga != NULL);
+    if (riga != NULL)
+    {
+        GPtrArray *voci = plex ? st->ini : st->segnalibri;
+        int indice = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (riga), "indice"));
+
+        gtk_widget_set_sensitive (st->btn_su, indice > 0);
+        gtk_widget_set_sensitive (st->btn_giu, (guint) indice < voci->len - 1);
+    }
+#endif
+}
+
+static void
+su_selezione (GtkListBox *box, GtkListBoxRow *riga, gpointer dato)
+{
+    StatoConfig *st = dato;
+
+    if (riga != NULL)
+    {
+        /* una sola lista seleziona alla volta */
+        if (box == GTK_LIST_BOX (st->lista_lavoro))
+        {
+            st->sel_lavoro = riga;
+            st->sel_plex = NULL;
+            gtk_list_box_select_row (GTK_LIST_BOX (st->lista_plex), NULL);
+        }
+        else
+        {
+            st->sel_plex = riga;
+            st->sel_lavoro = NULL;
+            gtk_list_box_select_row (GTK_LIST_BOX (st->lista_lavoro), NULL);
+        }
+    }
+    /* la lista ha perso la selezione: GtkListBox lo dice DOPO aver tolto
+     * la riga selezionata (ricostruisci_*, chiusura della finestra), che
+     * a quel punto e' gia' distrutta. Il SUO puntatore si azzera qui,
+     * prima che aggiorna_bottoni lo legga (03.11, prova nuova:
+     * GLib-GObject-CRITICAL in g_object_get_data sulla riga distrutta) */
+    else if (box == GTK_LIST_BOX (st->lista_lavoro))
+    {
+        st->sel_lavoro = NULL;
+    }
+    else
+    {
+        st->sel_plex = NULL;
+    }
+    aggiorna_bottoni (st);
+}
+
+#ifdef CODLAB_INC4B
+/* INC-4b, spento: «Sposta su» e «Sposta giù» (vedi la testata del file) */
+static void
+sposta (StatoConfig *st, int verso)
+{
+    GtkListBoxRow *riga = st->sel_plex != NULL ? st->sel_plex : st->sel_lavoro;
+    gboolean plex = st->sel_plex != NULL;
+
+    if (riga == NULL)
+    {
+        return;
+    }
+    int indice = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (riga), "indice"));
+    GPtrArray *voci = plex ? st->ini : st->segnalibri;
+    int nuovo = indice + verso;
+
+    if (nuovo < 0 || (guint) nuovo >= voci->len)
+    {
+        return;
+    }
+    gpointer tmp = g_ptr_array_index (voci, indice);
+
+    g_ptr_array_index (voci, indice) = g_ptr_array_index (voci, nuovo);
+    g_ptr_array_index (voci, nuovo) = tmp;
+
+    if (plex)
+    {
+        salva_ini (st);
+        ricostruisci_plex (st);
+    }
+    else
+    {
+        salva_segnalibri (st);
+        ricostruisci_lavoro (st);
+    }
+    /* la riga spostata resta selezionata, al suo posto nuovo */
+    GtkListBox *lista = plex ? GTK_LIST_BOX (st->lista_plex) : GTK_LIST_BOX (st->lista_lavoro);
+    GtkListBoxRow *nuova_riga = gtk_list_box_get_row_at_index (lista, nuovo);
+
+    if (nuova_riga != NULL)
+    {
+        gtk_list_box_select_row (lista, nuova_riga);
+    }
+    aggiorna_bottoni (st);
+}
+#endif
