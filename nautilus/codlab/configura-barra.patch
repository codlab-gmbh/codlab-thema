+/* ------------------------------------------------- dialoghi (AdwDialog) */
+
+static void
+dati_dialogo_free (gpointer dato)
+{
+    g_free (dato);
+}
+
+/* Chiude il dialogo dall'«Annulla» (o dopo la conferma riuscita). */
+static void
+chiudi_dialogo_da_bottone (GtkButton *pulsante, gpointer dato)
+{
+    adw_dialog_close (ADW_DIALOG (dato));
+}
+
+/* Aggiunge la riga delle risposte in FONDO al dialogo (come AdwAlertDialog):
+ * «Annulla» e il bottone PRIMARIO a destra. Nella testata il pack_end NON
+ * compariva (misurato su X11/AdwDialog: solo titolo e Annulla), e la riga
+ * in basso e' anche piu' leggibile per l'OCR delle prove. Il primario resta
+ * SENZA classe suggested-action: in questo ambiente il bianco-su-azzurro
+ * e' illeggibile per tesseract (misurato 01.11 su crop al 400%) e le prove
+ * cliccano proprio quel bottone. */
+static void
+fondo_con_risposta (AdwDialog *dialogo, GtkWidget *vista,
+                    const char *etichetta,
+                    gboolean (*conferma) (DatiDialogo *), DatiDialogo *d)
+{
+    GtkWidget *fondo = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 8);
+    GtkWidget *spazio = gtk_label_new ("");
+    GtkWidget *annulla = gtk_button_new_with_label (_("Cancel"));
+    GtkWidget *primario = gtk_button_new_with_label (etichetta);
+
+    gtk_widget_set_hexpand (spazio, TRUE);
+    g_signal_connect (annulla, "clicked", G_CALLBACK (chiudi_dialogo_da_bottone),
+                      dialogo);
+    g_object_set_data_full (G_OBJECT (dialogo), "conferma", conferma, NULL);
+    g_object_set_data_full (G_OBJECT (dialogo), "dati", d, dati_dialogo_free);
+    g_object_set_data (G_OBJECT (primario), "dialogo", dialogo);
+    g_signal_connect (primario, "clicked", G_CALLBACK (su_conferma_dialogo), d);
+    gtk_box_append (GTK_BOX (fondo), spazio);
+    gtk_box_append (GTK_BOX (fondo), annulla);
+    gtk_box_append (GTK_BOX (fondo), primario);
+    g_object_set (fondo, "margin-top", 2, "margin-bottom", 14,
+                  "margin-start", 14, "margin-end", 14, NULL);
+    adw_toolbar_view_add_bottom_bar (ADW_TOOLBAR_VIEW (vista), fondo);
+}
+
+/* Il bottone primario di un dialogo: ritrora dialogo e callback dai dati
+ * del dialogo stesso, chiude solo se la conferma riesce. */
+static void
+su_conferma_dialogo (GtkButton *pulsante, gpointer dato)
+{
+    DatiDialogo *d = dato;
+    AdwDialog *dialogo = g_object_get_data (G_OBJECT (pulsante), "dialogo");
+    gboolean (*conferma) (DatiDialogo *) =
+        g_object_get_data (G_OBJECT (dialogo), "conferma");
+
+    if (conferma != NULL && conferma (d))
+    {
+        adw_dialog_close (dialogo);
+    }
+}
+
+/* Il guscio comune: AdwDialog con testata (titolo + Annulla/primario) e
+ * contenuto a margine. Il puntatore DatiDialogo resta del dialogo. */
+static AdwDialog *
+guscio_dialogo (const char *titolo, const char *etichetta_primaria,
+                gboolean (*conferma) (DatiDialogo *), DatiDialogo *d,
+                GtkWidget **contenuto_fuori)
+{
+    AdwDialog *dialogo = adw_dialog_new ();
+    GtkWidget *vista = adw_toolbar_view_new ();
+    GtkWidget *testa = adw_header_bar_new ();
+    GtkWidget *titolo_widget = adw_window_title_new (titolo, NULL);
+    GtkWidget *contenuto = gtk_box_new (GTK_ORIENTATION_VERTICAL, 12);
+
+    adw_dialog_set_title (dialogo, titolo);
+    adw_window_title_set_title (ADW_WINDOW_TITLE (titolo_widget), titolo);
+    adw_header_bar_set_title_widget (ADW_HEADER_BAR (testa), titolo_widget);
+    adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (vista), testa);
+    g_object_set (contenuto, "margin-top", 18, "margin-bottom", 6,
+                  "margin-start", 18, "margin-end", 18, NULL);
+    adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (vista), contenuto);
+    adw_dialog_set_child (dialogo, vista);
+    adw_dialog_set_content_width (dialogo, 420);
+    fondo_con_risposta (dialogo, vista, etichetta_primaria, conferma, d);
+    *contenuto_fuori = contenuto;
+    return dialogo;
+}
+
+/* ---------------------------------------------------- Rinomina la voce */
+
+static gboolean
+conferma_rinomina (DatiDialogo *d)
+{
+    const char *testo = gtk_editable_get_text (GTK_EDITABLE (d->voce_nome));
+
+    if (testo == NULL || *testo == '\0' || strpbrk (testo, "\r\n") != NULL)
+    {
+        return FALSE;
+    }
+    if (d->plex)
+    {
+        SezioneIni *s = g_ptr_array_index (d->st->ini, d->indice);
+        char *prima = s->nome;
+
+        s->nome = g_strdup (testo);
+        if (!salva_ini (d->st))
+        {
+            /* niente scritto: il modello resta quello del file */
+            g_free (s->nome);
+            s->nome = prima;
+            return FALSE;
+        }
+        g_free (prima);
+        ricostruisci_plex (d->st);
+    }
+    else
+    {
+        RigaSegnalibro *r = g_ptr_array_index (d->st->segnalibri, d->indice);
+        char *prima = r->etichetta;
+
+        r->etichetta = g_strdup (testo);
+        if (!salva_segnalibri (d->st))
+        {
+            g_free (r->etichetta);
+            r->etichetta = prima;
+            return FALSE;
+        }
+        g_free (prima);
+        ricostruisci_lavoro (d->st);
+    }
+    GtkListBox *lista = d->plex ? GTK_LIST_BOX (d->st->lista_plex) :
+                       GTK_LIST_BOX (d->st->lista_lavoro);
+
+    gtk_list_box_select_row (lista, gtk_list_box_get_row_at_index (lista, d->indice));
+    aggiorna_bottoni (d->st);
+    aggiorna_sottotitolo (d->st);
+    return TRUE;
+}
+
+static void
+apri_dialogo_rinomina (StatoConfig *st, gboolean plex, int indice)
+{
+    const char *nome = plex ?
+        ((SezioneIni *) g_ptr_array_index (st->ini, indice))->nome :
+        ((RigaSegnalibro *) g_ptr_array_index (st->segnalibri, indice))->etichetta;
+    GtkWidget *contenuto = NULL;
+    DatiDialogo *d = g_new0 (DatiDialogo, 1);
+    AdwDialog *dialogo = guscio_dialogo (_("Rename entry"), _("Confirm"),
+                                          conferma_rinomina, d, &contenuto);
+    GtkWidget *riga = adw_entry_row_new ();
+
+    d->st = st;
+    d->plex = plex;
+    d->indice = indice;
+    d->voce_nome = riga;
+
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (riga), _("Name"));
+    gtk_editable_set_text (GTK_EDITABLE (riga), nome != NULL ? nome : "");
+    gtk_box_append (GTK_BOX (contenuto), riga);
+    adw_dialog_present (dialogo, st->finestra);
+}
