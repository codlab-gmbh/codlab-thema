+/* CodLab: profondita' — il gesto e' identico a quello dell'abbinamento
+ * testo: si scrive la preferenza (schema nostro) e il query-editor,
+ * che ascolta la chiave, rifarla la ricerca */
+static void
+depth_option_clicked (NautilusSearchPopover *self,
+                      GtkButton             *button)
+{
+    /* CodLab: senza lo schema nostro (pacchetto rimosso) il gruppo e'
+     * nascosto e qui non si arriva; mai dereferenziare NULL */
+    if (nautilus_codlab_preferences == NULL)
+    {
+        return;
+    }
+
+    gboolean solo_qui = (button == self->depth_here_button);
+    gboolean era_solo_qui = g_settings_get_boolean (nautilus_codlab_preferences,
+                                                    NAUTILUS_CODELAB_PREFERENCES_RICERCA_SOLO_QUI);
+
+    if (solo_qui != era_solo_qui)
+    {
+        g_settings_set_boolean (nautilus_codlab_preferences,
+                                NAUTILUS_CODELAB_PREFERENCES_RICERCA_SOLO_QUI,
+                                solo_qui);
+        set_active_button (&self->active_depth_button, button);
+    }
+}
