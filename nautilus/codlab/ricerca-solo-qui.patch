--- a/data/org.gnome.nautilus.codlab.gschema.xml	1970-01-01 01:00:00.000000000 +0100
+++ b/data/org.gnome.nautilus.codlab.gschema.xml	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<schemalist>
+  <!-- Schema CodLab per le preferenze nostre di Nautilus «potente».
+       Separato dallo schema upstream: sopravvive agli aggiornamenti di
+       Nautilus senza toccare le loro chiave. -->
+  <schema path="/org/gnome/nautilus/codlab/" id="org.gnome.nautilus.codlab" gettext-domain="nautilus">
+    <key type="b" name="ricerca-solo-qui">
+      <default>false</default>
+      <summary>Search only in the current folder</summary>
+      <description>When true, file search does not descend into
+      subfolders, whatever the value of recursive-search. Like the
+      “current folder / all subfolders” switch of Windows
+      Explorer. Set by the search popover “Depth” group.</description>
+    </key>
+  </schema>
+</schemalist>
