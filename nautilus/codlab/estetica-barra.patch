diff --git a/src/nautilus-sidebar-capacity.h b/src/nautilus-sidebar-capacity.h
new file mode 100644
index 0000000..fd65dc8
--- /dev/null
+++ b/src/nautilus-sidebar-capacity.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <glib.h>
+
+typedef struct {
+    guint64 free_bytes;
+    double used_fraction;
+    guint level;
+} NautilusSidebarCapacity;
+
+static inline gboolean
+nautilus_sidebar_capacity_calculate (guint64 total, guint64 available,
+                                     NautilusSidebarCapacity *result)
+{
+    if (total == 0)
+    {
+        return FALSE;
+    }
+    result->free_bytes = MIN (available, total);
+    result->used_fraction = (double) (total - result->free_bytes) / (double) total;
+    result->level = result->free_bytes < G_GUINT64_CONSTANT (100000000000) ? 2 :
+                    result->free_bytes < G_GUINT64_CONSTANT (200000000000) ? 1 : 0;
+    return TRUE;
+}
