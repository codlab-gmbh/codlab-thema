def fedora_piu_nuovo():
    """Il nautilus piu' nuovo che Fedora pubblica, dai repo SORGENTE (li' non c'e' esclusione)."""
    cmd = [DNF, "-q", "repoquery", "--latest-limit=1", "--qf", "%{version}-%{release}\n"]
    for r in REPO_SORGENTE:
        cmd += ["--repo", r]
    r = uscita(cmd + ["nautilus"], ambiente={"LC_ALL": "C"})
    versioni = [v for v in r.stdout.split() if re.fullmatch(r"[0-9][^\s]*-[0-9][^\s]*", v)]
    if r.returncode != 0 or not versioni:
        raise Guasto("non riesco a leggere i repo sorgente di Fedora: " + (r.stderr.strip()[-200:] or "?"))
    import functools
    return sorted(versioni, key=functools.cmp_to_key(vercmp))[-1]


def nel_repo(repo, nome="nautilus"):
    """La build CodLab piu' nuova di `nome` che il repo PUBBLICA davvero ("versione-release"), o None:
    nei metadati, sul disco e con la somma dei metadati. Un RPM copiato in Packages/ ma non nei metadati
    non conta (S2): nessun cliente di libdnf5 lo vede."""
    try:
        pub = metadati(repo)
    except Guasto:
        return None
    voci = [vr for loc, (n, vr, (tipo, somma)) in pub.items()
            if n == nome and os.path.isfile(os.path.join(repo, loc))
            and _somma(os.path.join(repo, loc), tipo) == somma]
    if not voci:
        return None
    import functools
    return sorted(voci, key=functools.cmp_to_key(vercmp))[-1]


def decidi(fedora, nostro, codlab_rel):
    """Serve ricostruire? fedora = "51.1-2.fc45" (Fedora piu' nuovo), nostro = "51.1-2.1.codlab.fc45"
    (il piu' nuovo dei nostri, installato o nel repo) o None. Il nostro e' «allineato» quando ha la
    stessa versione e la stessa base di release di Fedora e la revisione della serie in vigore."""
    v_f, r_f = fedora.rsplit("-", 1)
    obiettivo = "%s-%s.%s.codlab.%s" % (v_f, base_fedora(r_f), codlab_rel, r_f.rsplit(".", 1)[-1])
    if nostro is None:
        return True, obiettivo, "nessun nautilus CodLab"
    if vercmp(nostro, obiettivo) >= 0:
        return False, obiettivo, "il nostro %s e' gia' alla pari o piu' nuovo di %s" % (nostro, obiettivo)
    return True, obiettivo, "Fedora %s: il nostro %s va ricostruito come %s" % (fedora, nostro, obiettivo)


def leggi_stato():
    try:
        return json.load(open(STATO))
    except (OSError, ValueError):
        return {}


def scrivi_stato(s):
    os.makedirs(os.path.dirname(STATO), exist_ok=True)
    tmp = STATO + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1, ensure_ascii=False)
    os.replace(tmp, STATO)


def avvisa(titolo, testo, livello="normal", cosa_fare=None):
    cmd = [AVVISA, titolo, testo, livello] + ([cosa_fare] if cosa_fare else [])
    try:
        subprocess.run(cmd, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        print("avviso non consegnato: %s — %s" % (titolo, testo), file=sys.stderr)


def cmd_controlla(a):
    serie = leggi_serie(a.serie)
    try:
        fedora = a.fedora or fedora_piu_nuovo()
    except Guasto as e:
        print("GUASTO: %s" % e, file=sys.stderr)
        return 1
    inst = installato("nautilus")
    repo = nel_repo(a.repo)
    nostri = [v for v in (inst, repo) if v and ".codlab." in v]
    import functools
    nostro = sorted(nostri, key=functools.cmp_to_key(vercmp))[-1] if nostri else None
    serve, obiettivo, perche = decidi(fedora, nostro, serie["codlab_rel"])
    d = {"fedora": fedora, "installato": inst, "nel_repo": repo, "serie": serie["serie"],
         "codlab_rel": serie["codlab_rel"], "obiettivo": obiettivo, "serve_ricostruire": serve,
         "perche": perche}
    print(json.dumps(d, indent=1, ensure_ascii=False) if a.json else
          "%s\n  installato %s, nel repo %s, Fedora %s" % (perche, inst, repo, fedora))
    return 0


def cmd_automatico(a):
    os.makedirs(os.path.dirname(STATO) or ".", exist_ok=True)
    lock = open(os.path.join(os.path.dirname(STATO), ".ricostruisci.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0                               # un altro giro e' gia' al lavoro
    serie = leggi_serie(a.serie)
    stato = leggi_stato()
    problemi = incoerenze(a.repo)
    if problemi:
        # i file del repo e i suoi metadati non combaciano (S2): si ripara PRIMA di decidere, perche' la
        # decisione legge i metadati
        try:
            ripara(a.repo)
            print("repo codlab riparato: " + "; ".join(problemi)[:300])
        except Guasto as e:
            m = "repo codlab incoerente e non riparato: %s (%s)" % (e, "; ".join(problemi)[:200])
            print("ROSSO: " + m, file=sys.stderr)
            if stato.get("ultimo_avviso") != "ripara|" + m[:80]:
                avvisa("Repo CodLab: metadati non riparati", "%s. I pacchetti installati restano; il repo "
                       "codlab non pubblica cio' che ha su disco." % m, "critical",
                       "sudo createrepo_c --update %s, poi sudo systemctl start nautilus-barra.service" % a.repo)
                stato["ultimo_avviso"] = "ripara|" + m[:80]
            stato.update({"ultimo_giro": time.strftime("%F %T"), "esito": "rosso", "motivo": m})
            scrivi_stato(stato)
            return 1
    try:
        fedora = fedora_piu_nuovo()
    except Guasto as e:
        print("GUASTO: %s" % e, file=sys.stderr)
        return 0        # rete o mirror giu': nessun danno, si riprova al prossimo giro, senza avviso
    inst = installato("nautilus")
    repo = nel_repo(a.repo)
    import functools
    nostri = [v for v in (inst, repo) if v and ".codlab." in v]
    nostro = sorted(nostri, key=functools.cmp_to_key(vercmp))[-1] if nostri else None
    serve, obiettivo, perche = decidi(fedora, nostro, serie["codlab_rel"])
    print(perche)
    if not serve:
        return 0
    lavoro = os.path.join(LAVORO, obiettivo)
    shutil.rmtree(lavoro, ignore_errors=True)
    os.makedirs(lavoro)
    scarico = os.path.join(lavoro, "srpm")
    os.makedirs(scarico)
    try:
        cmd = [DNF, "-q", "download", "--destdir", scarico]
        for r in REPO_SORGENTE:
            cmd += ["--repo", r]
        if esegui(cmd + ["nautilus-%s.src" % fedora], log=os.path.join(lavoro, "download.log")) != 0:
            raise Guasto("non riesco a scaricare l'SRPM nautilus-%s: %s" % (
                fedora, motivo(os.path.join(lavoro, "download.log"))))
        srpm = glob.glob(os.path.join(scarico, "nautilus-*.src.rpm"))
        if len(srpm) != 1:
            raise Guasto("scaricati %d SRPM invece di 1" % len(srpm))
        k = uscita(["rpm", "-K", srpm[0]], ambiente={"LC_ALL": "C"})
        if k.returncode != 0 or "signatures OK" not in k.stdout:
            raise Guasto("l'SRPM non ha una firma Fedora valida: " + (k.stdout + k.stderr).strip()[:200])
        rpm_dir = os.path.join(lavoro, "rpm")
        costruisci(srpm[0], serie, rpm_dir, os.path.join(lavoro, "build"), utente=UTENTE,
                   cpu=a.cpu, builddep=False)
        esiti = prova(rpm_dir, fedora.split("-")[0], serie.get("marcatori", []),
                      lavoro=os.path.join(lavoro, "build", "tmp"), utente=UTENTE)
        pubblica(rpm_dir, a.repo)
    except Guasto as e:
        m = str(e)
        rimandato = m.startswith("RIMANDATO")
        dipendenze = isinstance(e, DipendenzeMancanti)
        chiave = "%s|%s" % (obiettivo, m[:80])
        print(("RIMANDATO: " if rimandato else "IN ATTESA: " if dipendenze else "ROSSO: ") + m, file=sys.stderr)
        if stato.get("ultimo_avviso") != chiave:
            if dipendenze:
                avvisa("Nautilus CodLab: ricostruzione in attesa di dipendenze",
                       "%s. Resta il nostro %s: niente e' stato sostituito, nessuna rottura. Le installa "
                       "l'ingresso a mano, senza una transazione offline in coda, poi il giro dopo ricostruisce."
                       % (m, inst or "?"), "normal",
                       "solo se «sudo env LC_ALL=C dnf5 offline status» dice «No offline transaction is "
                       "stored»: %s; poi sudo systemctl start nautilus-barra.service" % e.comando())
            else:
                avvisa("Nautilus CodLab: ricostruzione %s" % ("rimandata" if rimandato else "NON riuscita"),
                       "%s. Resta il nostro %s: niente e' stato sostituito, nessuna rottura. Lavoro: %s"
                       % (m, inst or "?", lavoro),
                       "low" if rimandato else "critical",
                       None if rimandato else "le patch vanno portate a mano sulla versione nuova (banco nautilus)")
            stato["ultimo_avviso"] = chiave
        stato.update({"ultimo_giro": time.strftime("%F %T"),
                      "esito": "rimandato" if rimandato else "dipendenze" if dipendenze else "rosso",
                      "obiettivo": obiettivo, "motivo": m})
        scrivi_stato(stato)
        return 0 if rimandato else 1
    stato.update({"ultimo_giro": time.strftime("%F %T"), "esito": "pubblicato", "obiettivo": obiettivo,
                  "motivo": "; ".join(esiti), "ultimo_avviso": None})
    scrivi_stato(stato)
    avvisa("Nautilus CodLab %s pronto" % obiettivo,
           "Fedora ha pubblicato nautilus %s: le patch CodLab (serie %s) sono state ricostruite sopra, "
           "provate e messe nel repo locale «codlab». Arriva col prossimo aggiornamento, al riavvio che "
           "decidi tu; fino ad allora resta il nostro %s." % (fedora, serie["serie"], inst or "?"), "normal")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="codlab-nautilus-ricostruisci", add_help=False,
                                description="Il Nautilus CodLab si ricostruisce a monte di Fedora.")
    p.add_argument("--aiuto", action="help")
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("controlla", add_help=False)
    c.add_argument("--aiuto", action="help")
    c.add_argument("--serie", default=None)
    c.add_argument("--repo", default=REPO)
    c.add_argument("--fedora", help="versione-release Fedora da usare al posto dei repo (prove)")
    c.add_argument("--json", action="store_true")
    c.set_defaults(f=cmd_controlla)

    s = sub.add_parser("prepara-spec", add_help=False)
    s.add_argument("--aiuto", action="help")
    s.add_argument("--serie", default=None)
    s.add_argument("--spec", required=True)
    s.add_argument("--uscita", required=True)
    s.add_argument("--rel-base", required=True)
    s.add_argument("--versione-fedora", required=True)
    s.set_defaults(f=cmd_prepara_spec)

    b = sub.add_parser("costruisci", add_help=False)
    b.add_argument("--aiuto", action="help")
    b.add_argument("--serie", default=None)
    b.add_argument("--srpm", required=True)
    b.add_argument("--uscita", required=True)
    b.add_argument("--lavoro", required=True)
    b.add_argument("--utente", default=None)
    b.add_argument("--cpu", type=int, default=8)
    b.add_argument("--builddep", action="store_true",
                   help="installa le dipendenze di build (root, SOLO a mano e senza coda offline; "
                        "il giro automatico non lo fa mai)")
    b.set_defaults(f=cmd_costruisci)

    v = sub.add_parser("prova", add_help=False)
    v.add_argument("--aiuto", action="help")
    v.add_argument("--serie", default=None)
    v.add_argument("--rpm-dir", required=True)
    v.add_argument("--versione-attesa")
    v.add_argument("--marcatore", action="append")
    v.add_argument("--senza-risoluzione", action="store_true")
    v.set_defaults(f=cmd_prova)

    u = sub.add_parser("pubblica", add_help=False)
    u.add_argument("--aiuto", action="help")
    u.add_argument("--rpm-dir", required=True)
    u.add_argument("--repo", default=REPO)
    u.add_argument("--tieni", type=int, default=TIENI)
    u.set_defaults(f=cmd_pubblica)

    t = sub.add_parser("automatico", add_help=False)
    t.add_argument("--aiuto", action="help")
    t.add_argument("--serie", default=None)
    t.add_argument("--repo", default=REPO)
    t.add_argument("--cpu", type=int, default=8)
    t.set_defaults(f=cmd_automatico)

    a = p.parse_args(argv)
    return a.f(a)


if __name__ == "__main__":
    sys.exit(main())
