#!/bin/bash
# nautilus-barra-aggiorna — dal 02.11.2026 e' solo l'ingresso storico (nautilus-barra.service/.timer)
# di codlab-nautilus-ricostruisci, che ricostruisce il Nautilus CodLab A MONTE di Fedora e lo pubblica
# nel repo locale «codlab» senza installare niente a caldo (vedi la sua intestazione).
#
# Fino al 01.11 questo script ricostruiva DOPO che Fedora aveva gia' sostituito il nostro, installava
# a caldo, e non dichiarava lo schema org.gnome.nautilus.codlab in %files: dalla 1.7 la sua
# ricostruzione sarebbe fallita. La sua ultima versione e' in git (strumenti 2607a4b) e nel pacchetto
# di ritorno nautilus-codlab-integrazione-20261031-4.
exec /usr/local/bin/codlab-nautilus-ricostruisci automatico
