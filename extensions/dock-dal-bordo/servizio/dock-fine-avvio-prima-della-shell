"""Dock dal bordo, versione 2: PRIMA della Shell, se multi-monitor di Dash to Dock è vero lo spegne e
scrive il segno ~/.config/meraviglioso/dock-dal-bordo-mm-sospeso; dock-dal-bordo (versione 2), trovato il segno durante
l'avvio, lo riaccende a 'startup-complete'. Così Dash to Dock all'avvio crea il solo dock principale e il dock del 2K nasce
a Shell avviata, subito nello stage: niente 219 avvisi st_widget_get_theme_node per ondata. Se multi-monitor è già falso
(spento di proposito) non tocca niente. Uscita 0 sempre, salvo chiavi illeggibili (78): mai fermare l'accesso."""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

SCHEMA, CHIAVE = 'org.gnome.shell.extensions.dash-to-dock', 'multi-monitor'
SEGNO = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'meraviglioso' / 'dock-dal-bordo-mm-sospeso'


def gs(*a):
    return subprocess.run(['gsettings', *a], capture_output=True, text=True, timeout=10)


def main():
    r = gs('get', SCHEMA, CHIAVE)
    if r.returncode != 0:
        print(f'dock-fine-avvio: {SCHEMA} {CHIAVE} illeggibile ({r.stderr.strip()[:120]}): niente', file=sys.stderr)
        return 78
    if r.stdout.strip() != 'true':
        print(f'dock-fine-avvio: multi-monitor {r.stdout.strip()}: niente da rinviare')
        return 0
    SEGNO.parent.mkdir(parents=True, exist_ok=True)
    tmp = SEGNO.with_name(SEGNO.name + '.tmp')
    tmp.write_text(json.dumps({'ora': time.strftime('%F %T %Z'), 'quando': 'prima della Shell'}) + '\n')
    tmp.replace(SEGNO)                        # il segno PRIMA di spegnere: se poi qualcosa cade, la Shell lo riaccende
    w = gs('set', SCHEMA, CHIAVE, 'false')
    print(f'dock-fine-avvio: segno {SEGNO}, multi-monitor false ({"ok" if w.returncode == 0 else w.stderr.strip()[:120]})')
    return 0


if __name__ == '__main__':
    sys.exit(main())
